---
import "../styles/home-v2.css";

interface Props {
  lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const en = lang === "en";

const homeUrl = en ? "/en/" : "/";
const restaurantUrl = en ? "/en/restaurants/" : "/restaurants/";
const automationUrl = en ? "/en/automation/" : "/automatisation/";
const privacyUrl = en ? "/en/privacy/" : "/confidentialite/";
const legalUrl = en ? "/en/legal-notice/" : "/mentions-legales/";
const thankYouUrl = en ? "/en/thank-you/" : "/merci/";

const services = en
  ? [
      {
        number: "01",
        tag: "Core offer",
        title: "Business website",
        text: "A professional website built around your business, with a structure that reflects what your customers actually need.",
        items: [
          "Structure tailored to your activity",
          "Responsive design",
          "Simple content management",
          "Basic technical SEO",
          "Contact forms",
          "Launch & handover",
        ],
        priceLabel: "From",
        price: "€790 excl. VAT",
        href: "#pricing",
        link: "View the offer →",
        className: "service-featured",
        icon: "↗",
      },
      {
        number: "02",
        tag: "Tailored",
        title: "E-commerce",
        text: "An online store designed around your products, your customers and the way your business operates.",
        items: [
          "Product catalogue",
          "Online payments",
          "Delivery or pickup",
          "Content management",
          "Responsive design",
          "Integrations when needed",
        ],
        priceLabel: "Depending on your needs",
        price: "Custom quote",
        href: "#contact",
        link: "Discuss the project →",
        className: "service-commerce",
        icon: "◇",
      },
      {
        number: "03",
        tag: "Business process",
        title: "Custom automation",
        text: "A solution designed around your workflow to reduce repetitive work, connect tools and make information move automatically.",
        items: [
          "Process analysis",
          "API & software integrations",
          "Data processing",
          "Document generation",
          "Internal workflows",
          "Checks & reconciliation",
        ],
        priceLabel: "Project-based",
        price: "Custom quote",
        href: automationUrl,
        link: "Explore automation →",
        className: "service-automation",
        icon: "⌁",
      },
    ]
  : [
      {
        number: "01",
        tag: "Offre principale",
        title: "Site vitrine",
        text: "Un site professionnel construit autour de votre activité, avec une structure adaptée à ce que vos clients ont réellement besoin de trouver.",
        items: [
          "Structure adaptée à votre activité",
          "Design responsive",
          "Gestion simple des contenus",
          "SEO technique de base",
          "Formulaires de contact",
          "Mise en ligne & prise en main",
        ],
        priceLabel: "À partir de",
        price: "790 € HTVA",
        href: "#pricing",
        link: "Voir l’offre →",
        className: "service-featured",
        icon: "↗",
      },
      {
        number: "02",
        tag: "Sur mesure",
        title: "E-commerce",
        text: "Une boutique en ligne pensée autour de vos produits, de vos clients et du fonctionnement réel de votre activité.",
        items: [
          "Catalogue produits",
          "Paiement en ligne",
          "Livraison ou retrait",
          "Gestion des contenus",
          "Design responsive",
          "Intégrations si nécessaire",
        ],
        priceLabel: "Selon les besoins",
        price: "Sur devis",
        href: "#contact",
        link: "Discuter du projet →",
        className: "service-commerce",
        icon: "◇",
      },
      {
        number: "03",
        tag: "Process métier",
        title: "Automatisation sur mesure",
        text: "Une solution conçue autour de votre processus pour réduire les tâches répétitives, connecter vos outils et faire circuler l’information automatiquement.",
        items: [
          "Analyse du processus",
          "API & intégrations logicielles",
          "Traitement de données",
          "Génération de documents",
          "Workflows internes",
          "Contrôles & rapprochements",
        ],
        priceLabel: "Projet personnalisé",
        price: "Sur devis",
        href: automationUrl,
        link: "Découvrir l’automatisation →",
        className: "service-automation",
        icon: "⌁",
      },
    ];

const sectors = en
  ? [
      { icon: "01", title: "Restaurants & hospitality", text: "Menus, bookings, opening hours and a strong mobile experience.", href: restaurantUrl, link: "See the restaurant offer →" },
      { icon: "02", title: "Trades & construction", text: "Services, project galleries, service areas and quote requests.", href: "#contact", link: "Discuss your activity →" },
      { icon: "03", title: "Beauty & wellness", text: "Services, pricing, portfolios, opening hours and booking links.", href: "#contact", link: "Discuss your activity →" },
      { icon: "04", title: "Real estate", text: "Credibility, properties, valuation requests and direct enquiries.", href: "#contact", link: "Discuss your activity →" },
      { icon: "05", title: "Retail & local shops", text: "Brand universe, collections, practical information and e-commerce evolution.", href: "#contact", link: "Discuss your activity →" },
      { icon: "06", title: "Associations & non-profits", text: "Clear information, resources, actions, events and accessible contact paths.", href: "#contact", link: "Discuss your activity →" },
    ]
  : [
      { icon: "01", title: "Restaurants & Horeca", text: "Carte, réservation, horaires et expérience mobile pensée pour vos clients.", href: restaurantUrl, link: "Voir l’offre restaurants →" },
      { icon: "02", title: "Artisans & bâtiment", text: "Services, réalisations, zones d’intervention et demandes de devis.", href: "#contact", link: "Parler de votre activité →" },
      { icon: "03", title: "Beauté & bien-être", text: "Prestations, tarifs, réalisations, horaires et prise de rendez-vous.", href: "#contact", link: "Parler de votre activité →" },
      { icon: "04", title: "Immobilier", text: "Crédibilité, biens, demandes d’estimation et prises de contact directes.", href: "#contact", link: "Parler de votre activité →" },
      { icon: "05", title: "Commerces locaux", text: "Univers de marque, collections, informations pratiques et évolution e-commerce.", href: "#contact", link: "Parler de votre activité →" },
      { icon: "06", title: "Associations & ASBL", text: "Informations claires, ressources, actions, événements et contacts accessibles.", href: "#contact", link: "Parler de votre activité →" },
    ];

const faq = en
  ? [
      ["How many pages are included?", "We do not artificially limit a project to a fixed number of pages. The structure is defined around the needs of your activity. The final scope and price are confirmed before work starts."],
      ["Do I own my website?", "The domain, content and project access remain under your control. AVARA does not impose a multi-year website rental contract. If you change provider, the deliverable website files can be transferred."],
      ["Is there a mandatory monthly subscription?", "No. For a standard business website, hosting and light maintenance start at €59 excl. VAT per year. More advanced services are only added when they are actually needed."],
      ["Can I update the website myself?", "Yes. Essential content can be made editable through a simple content management interface, depending on the project."],
      ["How long does a website take?", "Timing depends on the amount of content, the features and how quickly materials are available. The expected schedule is agreed before development begins."],
      ["Can you connect my booking or business tools?", "Often, yes. Booking platforms, forms, APIs and third-party tools can be linked or integrated depending on what each service allows."],
      ["What does basic SEO include?", "A clean technical structure, page titles, metadata, sitemap, mobile performance and indexable pages. Ongoing SEO campaigns or content strategies are separate services."],
      ["What can be automated?", "Repetitive data entry, file processing, document generation, software-to-software synchronisation, checks, notifications and internal workflows are common examples. Every automation project starts with an analysis of the current process."],
    ]
  : [
      ["Combien de pages sont incluses ?", "Nous ne limitons pas artificiellement un projet à un nombre fixe de pages. La structure est définie selon les besoins de votre activité. Le périmètre et le prix sont confirmés avant le début du développement."],
      ["Suis-je propriétaire de mon site ?", "Le nom de domaine, les contenus et les accès du projet restent sous votre contrôle. AVARA n’impose pas de contrat de location du site sur plusieurs années. Si vous changez de prestataire, les fichiers livrables du site peuvent être transférés."],
      ["Y a-t-il un abonnement mensuel obligatoire ?", "Non. Pour un site vitrine standard, l’hébergement et la maintenance légère commencent à 59 € HTVA par an. Les services plus avancés ne sont ajoutés que lorsqu’ils sont réellement nécessaires."],
      ["Puis-je modifier mon site moi-même ?", "Oui. Les contenus essentiels peuvent être rendus modifiables depuis une interface simple, selon la configuration retenue pour le projet."],
      ["Combien de temps faut-il pour créer un site ?", "Le délai dépend du volume de contenu, des fonctionnalités et de la disponibilité des éléments nécessaires. Le planning estimatif est défini avant le démarrage."],
      ["Pouvez-vous connecter mon système de réservation ou mes outils ?", "Souvent, oui. Plateformes de réservation, formulaires, API et outils tiers peuvent être reliés ou intégrés selon les possibilités offertes par chaque service."],
      ["Que comprend le SEO de base ?", "Une structure technique propre, les titres de pages, métadonnées, sitemap, affichage mobile et pages correctement indexables. Une stratégie SEO continue ou la création régulière de contenu sont des prestations distinctes."],
      ["Que peut-on automatiser ?", "Encodages répétitifs, traitement de fichiers, génération de documents, synchronisation entre logiciels, contrôles, notifications ou workflows internes sont des exemples fréquents. Chaque projet commence par l’analyse du processus existant."],
    ];

const process = en
  ? [
      ["01", "Understand", "We look at your activity, your users and the result you want to achieve.", "Needs & scope"],
      ["02", "Design", "We define the right structure, user experience or technical solution before development.", "Solution design"],
      ["03", "Build & validate", "The project is developed, tested and reviewed with you before delivery.", "Development & review"],
      ["04", "Launch", "Website publication or automation deployment, handover and final checks.", "Go live"],
    ]
  : [
      ["01", "Comprendre", "Nous regardons votre activité, vos utilisateurs et le résultat que vous souhaitez obtenir.", "Besoin & périmètre"],
      ["02", "Concevoir", "Nous définissons la bonne structure, l’expérience ou la solution technique avant de développer.", "Conception"],
      ["03", "Développer & valider", "Le projet est développé, testé puis revu avec vous avant sa livraison.", "Développement & validation"],
      ["04", "Mettre en service", "Publication du site ou déploiement de l’automatisation, transfert et contrôles finaux.", "Mise en ligne"],
    ];
---

<header class="header">
  <div class="container navbar">
    <a href={homeUrl} class="brand-logo brand-logo-image" aria-label="AVARA by BLUVA">
      <img src="/images/logo-avara.png" alt="AVARA by BLUVA" />
    </a>

    <nav class="nav">
      <a href="#services">{en ? "Services" : "Services"}</a>
      <a href="#sectors">{en ? "Industries" : "Secteurs"}</a>
      <a href="#projects">{en ? "Projects" : "Projets"}</a>
      <a href="#pricing">{en ? "Pricing" : "Tarifs"}</a>
      <a href="#contact">Contact</a>
    </nav>

    <a href="#contact" class="button button-small">
      {en ? "Discuss my project" : "Parler de mon projet"}
    </a>
  </div>
</header>

<main>
  <section class="hero v2-hero">
    <div class="hero-glow hero-glow-one"></div>
    <div class="hero-glow hero-glow-two"></div>

    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          {en
            ? "Web development & automation · Charleroi, Belgium"
            : "Création de sites web & automatisation · Charleroi & Wallonie"}
        </div>

        <h1>
          {en ? "A professional website" : "Un site professionnel"}
          <span>{en ? "that belongs to you." : "qui vous appartient."}</span>
        </h1>

        <p class="hero-description">
          {en
            ? "Built to turn visitors into customers. AVARA creates modern business websites, e-commerce solutions and custom automations for freelancers and small businesses."
            : "Pensé pour transformer vos visiteurs en clients. AVARA crée des sites vitrines, e-commerce et automatisations sur mesure pour les indépendants et petites entreprises."}
        </p>

        <div class="hero-actions">
          <a href="#contact" class="button">
            {en ? "Discuss my project" : "Parler de mon projet"}
            <span class="button-arrow">→</span>
          </a>

          <a href="#projects" class="button button-secondary">
            {en ? "View projects" : "Voir les réalisations"}
          </a>
        </div>

        <div class="hero-proof">
          <div>
            <strong>{en ? "From €790" : "À partir de 790 €"}</strong>
            <span>{en ? "Excl. VAT · Business website" : "HTVA · Site vitrine"}</span>
          </div>

          <div class="proof-separator"></div>

          <div>
            <strong>{en ? "No monthly rental" : "Pas de location mensuelle"}</strong>
            <span>{en ? "Your project stays under your control" : "Votre projet reste sous votre contrôle"}</span>
          </div>

          <div class="proof-separator"></div>

          <div>
            <strong>{en ? "Custom quote" : "Sur devis"}</strong>
            <span>{en ? "E-commerce & automation" : "E-commerce & automatisation"}</span>
          </div>
        </div>
      </div>

      <div class="hero-showcase">
        <div class="showcase-orbit orbit-one"></div>
        <div class="showcase-orbit orbit-two"></div>

        <div class="desktop-window">
          <div class="desktop-topbar">
            <div class="browser-controls">
              <span></span><span></span><span></span>
            </div>
            <div class="browser-url">atelier-verde.be</div>
          </div>

          <div class="website-preview">
            <div class="preview-navigation">
              <div class="preview-brand">atelier<span>verde</span></div>
              <div class="preview-menu">
                <span>{en ? "Home" : "Accueil"}</span>
                <span>Services</span>
                <span>{en ? "Projects" : "Projets"}</span>
                <span>Contact</span>
              </div>
            </div>

            <div class="preview-hero">
              <div class="preview-copy">
                <span class="preview-label">{en ? "Architecture & renovation" : "Architecture & rénovation"}</span>
                <h3>{en ? "Spaces designed to last." : "Des espaces pensés pour durer."}</h3>
                <p>{en ? "Design, renovation and support for contemporary residential projects." : "Conception, rénovation et accompagnement de projets résidentiels contemporains."}</p>
                <div class="preview-button">{en ? "Explore our projects" : "Découvrir les projets"}</div>
              </div>
              <div class="preview-photo"></div>
            </div>

            <div class="preview-services">
              <div><span>01</span><strong>Architecture</strong></div>
              <div><span>02</span><strong>{en ? "Renovation" : "Rénovation"}</strong></div>
              <div><span>03</span><strong>Consulting</strong></div>
            </div>
          </div>
        </div>

        <div class="mobile-window">
          <div class="mobile-notch"></div>
          <div class="mobile-content">
            <div class="mobile-nav">
              <strong>atelier<span>verde</span></strong>
              <span>☰</span>
            </div>
            <div class="mobile-image"></div>
            <span class="mobile-label">Architecture</span>
            <h4>{en ? "Spaces designed to last." : "Des espaces pensés pour durer."}</h4>
            <div class="mobile-button">{en ? "Our projects" : "Nos projets"}</div>
          </div>
        </div>

        <div class="floating-card floating-card-one">
          <span class="floating-icon">✓</span>
          <div>
            <strong>Responsive</strong>
            <small>Mobile & desktop</small>
          </div>
        </div>

        <div class="floating-card floating-card-two">
          <span class="floating-icon">✦</span>
          <div>
            <strong>{en ? "Tailored" : "Sur mesure"}</strong>
            <small>{en ? "To your business" : "À votre activité"}</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="highlights">
    <div class="container highlight-grid">
      <div class="highlight">
        <strong>{en ? "€790" : "790 €"}</strong>
        <span>{en ? "excl. VAT · from" : "HTVA · à partir de"}</span>
        <p>{en ? "A structure tailored to your activity" : "Une structure adaptée à votre activité"}</p>
      </div>

      <div class="highlight">
        <strong>{en ? "Yours" : "À vous"}</strong>
        <span>{en ? "no multi-year rental" : "pas de location pluriannuelle"}</span>
        <p>{en ? "Domain, content and access stay under your control" : "Domaine, contenus et accès sous votre contrôle"}</p>
      </div>

      <div class="highlight">
        <strong>€59</strong>
        <span>{en ? "excl. VAT / year" : "HTVA / an"}</span>
        <p>{en ? "Hosting & light maintenance from" : "Hébergement & maintenance légère dès"}</p>
      </div>

      <div class="highlight">
        <strong>{en ? "Custom" : "Sur mesure"}</strong>
        <span>{en ? "business automation" : "automatisation métier"}</span>
        <p>{en ? "Built around your processes and tools" : "Construite autour de vos processus et outils"}</p>
      </div>
    </div>
  </section>

  <section id="services" class="section services-section">
    <div class="container">
      <div class="services-heading">
        <div>
          <p class="eyebrow">{en ? "Services" : "Services"}</p>
          <h2>{en ? "Digital solutions built around your business." : "Des solutions digitales construites autour de votre activité."}</h2>
        </div>

        <p>
          {en
            ? "A website, an online store or a business automation project should adapt to the way you work — not force your business into a generic template."
            : "Un site, une boutique en ligne ou un projet d’automatisation doit s’adapter à votre façon de travailler — pas l’inverse."}
        </p>
      </div>

      <div class="services-grid">
        {services.map((service) => (
          <article class={`service-card ${service.className}`}>
            <div class="service-top">
              <span class="service-number">{service.number}</span>
              <span class="service-tag neutral">{service.tag}</span>
            </div>

            <div class="service-icon">{service.icon}</div>
            <h3>{service.title}</h3>
            <p>{service.text}</p>

            <ul class="service-list">
              {service.items.map((item) => <li>{item}</li>)}
            </ul>

            <div class="service-price-row">
              <div>
                <span>{service.priceLabel}</span>
                <strong>{service.price}</strong>
              </div>
              <a href={service.href} class="service-link">{service.link}</a>
            </div>
          </article>
        ))}
      </div>

      <div class="support-strip">
        <div>
          <span class="support-strip-label">{en ? "Existing project?" : "Projet existant ?"}</span>
          <strong>{en ? "Improvements, new features and technical support" : "Évolutions, nouvelles fonctionnalités et support technique"}</strong>
        </div>
        <p>{en ? "Additional work can be handled at €65 excl. VAT/hour or on a fixed quote when the scope is known." : "Les évolutions hors périmètre peuvent être réalisées à 65 € HTVA/heure ou sur devis lorsque le besoin est défini."}</p>
      </div>
    </div>
  </section>

  <section id="sectors" class="section sectors-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{en ? "Industries" : "Secteurs"}</p>
          <h2>{en ? "A website designed for how your customers choose." : "Un site pensé pour la façon dont vos clients choisissent."}</h2>
        </div>
        <p class="section-intro">
          {en
            ? "A restaurant, a construction company and a real-estate professional do not need the same website. The structure, calls to action and content should reflect the business."
            : "Un restaurant, un terrassier et un professionnel de l’immobilier n’ont pas besoin du même site. La structure, les appels à l’action et les contenus doivent refléter le métier."}
        </p>
      </div>

      <div class="sectors-grid">
        {sectors.map((sector) => (
          <article class="sector-card">
            <span class="sector-number">{sector.icon}</span>
            <h3>{sector.title}</h3>
            <p>{sector.text}</p>
            <a href={sector.href}>{sector.link}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section ownership-section">
    <div class="container">
      <div class="ownership-card">
        <div class="ownership-copy">
          <p class="eyebrow">{en ? "No lock-in" : "Sans enfermement"}</p>
          <h2>{en ? "Your website. Your content. Your access." : "Votre site. Vos contenus. Vos accès."}</h2>
          <p>
            {en
              ? "AVARA does not build its business model around renting your website back to you for years. The domain and content remain under your control, and the deliverable project can be transferred if you decide to work with someone else."
              : "AVARA ne construit pas son modèle sur la location de votre propre site pendant plusieurs années. Le domaine et les contenus restent sous votre contrôle, et le projet livrable peut être transféré si vous décidez un jour de travailler avec un autre prestataire."}
          </p>
        </div>

        <div class="ownership-grid">
          <div>
            <span>01</span>
            <strong>{en ? "No multi-year website rental" : "Pas de location pluriannuelle"}</strong>
            <p>{en ? "You pay for the creation of your project, not for the right to keep using it." : "Vous payez la création de votre projet, pas le droit de continuer à l’utiliser."}</p>
          </div>
          <div>
            <span>02</span>
            <strong>{en ? "Domain under your control" : "Domaine sous votre contrôle"}</strong>
            <p>{en ? "The domain can remain registered in your name and connected to the website." : "Le nom de domaine peut rester enregistré à votre nom et relié au site."}</p>
          </div>
          <div>
            <span>03</span>
            <strong>{en ? "Transferable project" : "Projet transférable"}</strong>
            <p>{en ? "If the collaboration ends, the deliverable website files and access can be handed over." : "Si la collaboration s’arrête, les fichiers livrables du site et les accès peuvent être transmis."}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section ecosystem-general">
    <div class="container ecosystem-general-card">
      <div>
        <p class="eyebrow">{en ? "Your online presence" : "Votre présence en ligne"}</p>
        <h2>
          {en ? "Social media gets you noticed. Search gets you found. Your website helps people choose." : "Les réseaux vous font découvrir. Google vous fait trouver. Votre site vous fait choisir."}
        </h2>
        <p>
          {en
            ? "Facebook, Instagram and Google are useful channels. Your website brings your services, prices, work, opening hours and contact options together in one reliable place that you control."
            : "Facebook, Instagram et Google sont d’excellents canaux. Votre site rassemble vos services, tarifs, réalisations, horaires et moyens de contact dans un espace fiable qui vous appartient."}
        </p>
      </div>

      <div class="ecosystem-steps">
        <div><span>01</span><strong>Google</strong><small>{en ? "Find" : "Trouver"}</small></div>
        <span class="ecosystem-arrow">→</span>
        <div><span>02</span><strong>{en ? "Social" : "Réseaux"}</strong><small>{en ? "Discover" : "Découvrir"}</small></div>
        <span class="ecosystem-arrow">→</span>
        <div class="ecosystem-main"><span>03</span><strong>{en ? "Your website" : "Votre site"}</strong><small>{en ? "Understand & act" : "Comprendre & agir"}</small></div>
      </div>
    </div>
  </section>

  <section id="projects" class="section portfolio-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{en ? "Projects & concepts" : "Projets & réalisations"}</p>
          <h2>{en ? "A few of the worlds we can create." : "Quelques univers que nous pouvons créer."}</h2>
        </div>
        <p class="section-intro">
          {en
            ? "Demonstration concepts created to show different styles, industries and features. Real client projects will gradually complete this selection."
            : "Des concepts de démonstration créés pour illustrer différents styles, secteurs et fonctionnalités. Les réalisations clients viendront progressivement compléter cette sélection."}
        </p>
      </div>

      <div class="portfolio-grid">
        <article class="project-card project-large">
          <div class="project-preview restaurant-showcase-preview">
            <div class="restaurant-browser">
              <div class="restaurant-browser-bar">
                <div class="browser-controls"><span></span><span></span><span></span></div>
                <div class="restaurant-browser-url">lecomptoir27.be</div>
              </div>

              <div class="restaurant-showcase-site">
                <div class="restaurant-showcase-nav">
                  <div class="restaurant-logo">LE COMPTOIR <span>27</span></div>
