---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Merci — Bluva Studio"
  description="Votre demande a bien été envoyée à Bluva Studio."
>
  <main class="thank-you-page">
    <div class="thank-you-card">
      <a href="/" class="thank-you-brand">
        <span>BLUVA</span>
        <small>studio</small>
      </a>

      <div class="thank-you-icon">✓</div>

      <p class="thank-you-eyebrow">
        Message envoyé
      </p>

      <h1>
        Merci pour votre demande.
      </h1>

      <p class="thank-you-text">
        Votre message a bien été envoyé. Nous revenons vers vous
        rapidement pour discuter de votre projet.
      </p>

      <a href="/" class="button">
        Retour à l'accueil
        <span class="button-arrow">→</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .thank-you-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(109, 93, 252, 0.12),
        transparent 32%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(141, 225, 189, 0.12),
        transparent 30%
      ),
      #f7f7f4;
  }

  .thank-you-card {
    width: min(100%, 650px);
    padding: 60px;
    border: 1px solid rgba(23, 23, 23, 0.08);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.9);
    text-align: center;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.08);
  }

  .thank-you-brand {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 45px;
  }

  .thank-you-brand span {
    font-family: "Manrope", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .thank-you-brand small {
    color: #6d5dfc;
    font-size: 0.75rem;
  }

  .thank-you-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 25px;
    border-radius: 20px;
    background: rgba(109, 93, 252, 0.1);
    color: #6d5dfc;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .thank-you-eyebrow {
    color: #6d5dfc;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .thank-you-card h1 {
    margin-top: 14px;
    font-family: "Manrope", sans-serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .thank-you-text {
    max-width: 470px;
    margin: 24px auto 32px;
    color: #686868;
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .thank-you-card {
      padding: 42px 24px;
      border-radius: 24px;
    }
  }
</style>