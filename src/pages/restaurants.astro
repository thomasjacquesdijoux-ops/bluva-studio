    margin-bottom: 20px;
    border-radius: 100px 100px 15px 15px;
  }

  .home-screen h3 {
    margin-top: 10px;
    font-family: "Manrope", sans-serif;
    font-size: 1.75rem;
    line-height: 1;
  }

  .home-screen p {
