    padding: 55px;
    border-radius: 30px;
    background: #f1eee9;
  }

  .ecosystem-copy h2 {
    font-size: clamp(2.3rem, 4vw, 3.8rem);
  }

  .ecosystem-copy > p {
    margin-top: 22px;
  }

  .ecosystem-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 12px;
    align-items: center;
  }

  .ecosystem-item {
    min-height: 160px;
    padding: 20px;
    border-radius: 20px;
    background: white;
  }

  .ecosystem-main {
    background: #171717;
    color: white;
