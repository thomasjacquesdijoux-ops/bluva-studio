    background:
      linear-gradient(
        90deg,
        rgba(18, 12, 9, 0.92),
        rgba(18, 12, 9, 0.58) 43%,
        rgba(18, 12, 9, 0.12) 78%
      ),
      url("/images/restaurant-hero.jpg");
    background-size: cover;
    background-position: center;
