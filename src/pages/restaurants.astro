  .example-actions span {
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .example-bottom {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .example-bottom > div {
    display: flex;
    flex-direction: column;
    padding: 27px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .example-bottom > div:last-child {
    border-right: 0;
  }

  .example-bottom small {
    color: #d49a73;
  }

  .example-bottom strong {
    margin-top: 8px;
  }

  .example-bottom span {
    margin-top: 7px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.67rem;
  }

  .demo-note {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.7rem;
  }

  /* PRICING */

  .pricing-section {
    background: #f1eee9;
  }

  .pricing-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 80px;
    align-items: start;
  }

  .pricing-copy {
    position: sticky;
    top: 60px;
  }

  .pricing-copy > p {
    margin-top: 25px;
  }

  .pricing-card {
    padding: 42px;
    border-radius: 30px;
    background: white;
  }

  .price-top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 35px;
    border-bottom: 1px solid rgba(23, 23, 23, 0.1);
  }

  .price-top > span {
    color: #9b694e;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .price {
    text-align: right;
  }

  .price small {
    display: block;
    color: #77716b;
  }

  .price strong {
    display: block;
    font-family: "Manrope", sans-serif;
    font-size: 3.3rem;
    line-height: 1;
  }

  .price-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    padding: 35px 0;
  }

  .price-features div {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.83rem;
  }

  .price-features span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    border-radius: 8px;
    background: #f3e9e2;
    color: #9b694e;
    font-size: 0.65rem;
  }

  .hosting {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding: 20px;
    border-radius: 17px;
    background: #f4f1ed;
  }

  .hosting div {
    display: flex;
    flex-direction: column;
  }

  .hosting span {
    color: #77716b;
    font-size: 0.7rem;
  }

  .full-button {
    width: 100%;
    margin-top: 20px;
  }

  .price-reassurance {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 13px;
    background: #f7f2ed;
    color: #655e59;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .price-note {
    margin-top: 14px;
    color: #817b76;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  /* PROCESS */

  .process-section {
    background: white;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .process-grid article {
    min-height: 270px;
    padding: 28px;
    border: 1px solid rgba(23, 23, 23, 0.09);
    border-radius: 23px;
    background: #f7f5f1;
  }

  .process-grid article:nth-child(2) {
    background: #171717;
    color: white;
  }

  .process-grid article > span {
    color: #9b694e;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .process-grid h3 {
    margin-top: 70px;
    font-family: "Manrope", sans-serif;
    font-size: 1.35rem;
  }

  .process-grid p {
    margin-top: 10px;
    color: #77716b;
    font-size: 0.82rem;
  }

  .process-grid article:nth-child(2) p {
    color: rgba(255, 255, 255, 0.5);
  }

  /* FAQ */

  .faq-section {
    background: #f7f5f1;
  }

  .faq-grid {
    display: grid;
    gap: 12px;
    max-width: 900px;
    margin-left: auto;
  }

  .faq-item {
    overflow: hidden;
    border: 1px solid rgba(23, 23, 23, 0.09);
    border-radius: 18px;
    background: white;
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding: 23px 25px;
    cursor: pointer;
    list-style: none;
    font-family: "Manrope", sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary span {
    color: #9b694e;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .faq-item[open] summary span {
    transform: rotate(45deg);
  }

  .faq-item p {
    max-width: 760px;
    padding: 0 25px 25px;
    color: #706b66;
    font-size: 0.84rem;
    line-height: 1.7;
  }

  /* CTA */

  .final-cta {
    padding: 0 0 110px;
    background: #f7f5f1;
  }

  .cta-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 70px;
    align-items: center;
    padding: 65px;
    border-radius: 34px;
    background: #9c6b50;
    color: white;
  }

  .eyebrow.light {
    color: #f1d5c4;
  }

  .cta-card h2 {
    max-width: 700px;
    font-family: "Manrope", sans-serif;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .cta-card p:not(.eyebrow) {
    max-width: 610px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.68);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 15px;
  }

  .cta-white {
    min-height: 52px;
    padding: 0 22px;
    background: white;
    color: #171717;
  }

  .cta-mail {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
  }

