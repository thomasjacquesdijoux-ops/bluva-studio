  .phones {
    position: relative;
    min-height: 610px;
  }

  .phone {
    position: absolute;
    width: 270px;
    padding: 9px;
    border-radius: 42px;
    background: #171717;
    box-shadow: 0 35px 70px rgba(50, 30, 20, 0.2);
  }

