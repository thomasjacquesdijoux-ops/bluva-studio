---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Création de sites web pour restaurants | AVARA by BLUVA"
  description="Création de sites web modernes pour restaurants, brasseries et établissements horeca : menu, réservation, horaires, galerie et informations pratiques."
>
  <header class="restaurant-header">
    <div class="restaurant-container restaurant-nav">
      <a href="/" class="restaurant-logo" aria-label="AVARA by BLUVA">
        <img src="/images/logo-avara.png" alt="AVARA by BLUVA" />
      </a>

      <nav>
        <a href="#solution">Votre site</a>
        <a href="#exemple">Exemple</a>
        <a href="#tarif">Tarif</a>
        <a href="#process">Comment ça marche</a>
        <a href="#faq">FAQ</a>
      </nav>

      <a href="/#contact" class="button-small">
        Parler de mon projet
      </a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="restaurant-hero">
      <div class="restaurant-container hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            Sites web pour restaurants
          </div>

          <h1>
            Donnez envie de réserver
            <span>avant même d'arriver.</span>
          </h1>

          <p class="hero-text">
            Un site moderne pour présenter votre restaurant, votre carte,
            vos horaires et votre univers — avec une expérience pensée
            avant tout pour les visiteurs sur mobile.
          </p>

          <div class="hero-actions">
            <a href="/#contact" class="button-primary">
              Discuter de mon projet
              <span>→</span>
            </a>

            <a href="#exemple" class="button-secondary">
              Voir un exemple
            </a>
          </div>

          <div class="hero-points">
            <div>
              <strong>À partir de 790 €</strong>
              <span>HTVA · Site vitrine</span>
            </div>

            <div>
              <strong>59 € / an</strong>
              <span>Hébergement & maintenance légère</span>
            </div>

            <div>
              <strong>100 % responsive</strong>
              <span>Pensé pour le mobile</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image">
            <div class="hero-site">
              <div class="site-topbar">
                <div class="site-brand">
                  LE COMPTOIR <span>27</span>
                </div>

                <div class="site-menu">
                  <span>La carte</span>
                  <span>Le restaurant</span>
                  <span>Contact</span>
                  <strong>Réserver</strong>
                </div>
              </div>

              <div class="site-copy">
                <span>Bistrot · Cuisine de saison</span>

                <h2>
                  La cuisine qu'on aime partager.
                </h2>

                <p>
                  Des produits de saison, une cuisine généreuse
                  et une table pensée pour les bons moments.
                </p>

                <div class="fake-buttons">
                  <strong>Réserver une table</strong>
                  <span>Voir la carte</span>
                </div>
              </div>

              <div class="opening-card">
                <small>OUVERTURE</small>
                <strong>Mar — Sam</strong>
                <span>12:00 — 14:30</span>
                <span>18:30 — 22:30</span>
              </div>
            </div>
          </div>

          <div class="floating-mobile">
            <div class="mobile-top">
              <strong>LE COMPTOIR 27</strong>
              <span>☰</span>
            </div>

            <div class="mobile-photo"></div>

            <small>Cuisine de saison</small>

            <h3>
              Une table,
              une histoire.
            </h3>

            <div class="mobile-reserve">
              Réserver
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="restaurant-proof">
      <div class="restaurant-container proof-grid">
        <div>
          <strong>Menu</strong>
          <span>Accessible en quelques secondes</span>
        </div>

        <div>
          <strong>Réservation</strong>
          <span>Votre outil ou formulaire existant</span>
        </div>

        <div>
          <strong>Horaires</strong>
          <span>Immédiatement visibles</span>
        </div>

        <div>
          <strong>Mobile</strong>
          <span>Pensé pour les clients en déplacement</span>
        </div>
      </div>
    </section>

    <!-- SOLUTION -->
    <section id="solution" class="section solution-section">
      <div class="restaurant-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              Votre site
            </p>

            <h2>
              Tout ce qu'un client cherche avant de réserver.
            </h2>
          </div>

          <p>
            Pas besoin d'un site compliqué. L'objectif est de donner envie,
            répondre immédiatement aux questions essentielles et conduire
            naturellement le visiteur vers la réservation.
          </p>
        </div>

        <div class="feature-grid">
          <article class="feature-card feature-main">
            <span class="feature-number">01</span>

            <div class="feature-icon">☰</div>

            <h3>Votre carte</h3>

            <p>
              Une carte lisible sur mobile, facile à consulter et
              beaucoup plus agréable qu'un PDF perdu dans le site.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">02</span>

            <div class="feature-icon">↗</div>

            <h3>Réservation</h3>

            <p>
              Vous utilisez déjà Zenchef, TheFork, Resengo ou une autre
              solution ? Votre système actuel peut être relié au site.
              Si vous n'en avez pas encore, nous pouvons vous aider à
              choisir une solution adaptée.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">03</span>

            <div class="feature-icon">⌖</div>

            <h3>Accès & horaires</h3>

            <p>
              Adresse, heures d'ouverture, téléphone et itinéraire
              accessibles sans chercher.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">04</span>

            <div class="feature-icon">◇</div>

            <h3>Votre univers</h3>

            <p>
              Des photos, une identité visuelle et une mise en page
              cohérentes avec l'ambiance de votre établissement.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">05</span>

            <div class="feature-icon">◎</div>

            <h3>Google & SEO</h3>

            <p>
              Une structure technique propre pour permettre à Google
              de comprendre et indexer correctement votre site.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">06</span>

            <div class="feature-icon">✦</div>

            <h3>Facile à modifier</h3>

            <p>
              Horaires, textes ou informations importantes peuvent
              être modifiés sans reconstruire tout le site.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- DIGITAL ECOSYSTEM -->
    <section class="ecosystem-section">
      <div class="restaurant-container">
        <div class="ecosystem-card">
          <div class="ecosystem-copy">
            <p class="eyebrow">
              Votre présence en ligne
            </p>

            <h2>
              Déjà présent sur Google et Instagram ?
              C'est une bonne chose.
            </h2>

            <p>
              Votre site ne remplace pas vos autres canaux.
              Il les rassemble et donne à vos visiteurs un endroit fiable
              où retrouver votre univers, votre carte, vos horaires
              et votre réservation.
            </p>
          </div>

          <div class="ecosystem-flow">
            <div class="ecosystem-item">
              <span class="ecosystem-icon">G</span>

              <div>
                <strong>Google</strong>
                <p>Permet de vous trouver.</p>
              </div>
            </div>

            <div class="ecosystem-arrow">→</div>

            <div class="ecosystem-item">
              <span class="ecosystem-icon">◎</span>

              <div>
                <strong>Instagram</strong>
                <p>Permet de vous découvrir.</p>
              </div>
            </div>

            <div class="ecosystem-arrow">→</div>

            <div class="ecosystem-item ecosystem-main">
              <span class="ecosystem-icon">A</span>

              <div>
                <strong>Votre site</strong>
                <p>Permet de comprendre et réserver.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE -->
    <section class="mobile-first">
      <div class="restaurant-container mobile-first-grid">
        <div class="mobile-first-copy">
          <p class="eyebrow">
            Pensé mobile
          </p>

          <h2>
            Votre client est souvent déjà dans la rue quand il cherche votre restaurant.
          </h2>

          <p>
            Adresse, menu, horaires, téléphone et réservation doivent être
            immédiatement accessibles sur smartphone.
          </p>

          <div class="mobile-list">
            <div>
              <span>✓</span>
              Chargement rapide
            </div>

            <div>
              <span>✓</span>
              Navigation simple
            </div>

            <div>
              <span>✓</span>
              Bouton de réservation visible
            </div>

            <div>
              <span>✓</span>
              Téléphone et itinéraire accessibles
            </div>
          </div>
        </div>

        <div class="phones">
          <div class="phone phone-back">
            <div class="phone-screen menu-screen">
              <small>LE COMPTOIR 27</small>

              <h3>La carte</h3>

              <div class="menu-line">
                <span>Entrées</span>
                <strong>→</strong>
              </div>

              <div class="menu-line">
                <span>Plats</span>
                <strong>→</strong>
              </div>

              <div class="menu-line">
                <span>Desserts</span>
                <strong>→</strong>
              </div>

              <div class="menu-line">
                <span>Vins</span>
                <strong>→</strong>
              </div>
            </div>
          </div>

          <div class="phone phone-front">
            <div class="phone-screen home-screen">
              <div class="phone-image"></div>

              <small>BISTROT · NALINNES</small>

              <h3>
                La cuisine qu'on aime partager.
              </h3>

              <p>
                Ouvert aujourd'hui
                <strong>12:00 — 14:30</strong>
              </p>

              <div class="phone-button">
                Réserver une table
              </div>

              <div class="phone-links">
                <span>La carte</span>
                <span>Itinéraire</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- EXAMPLE -->
    <section id="exemple" class="section example-section">
      <div class="restaurant-container">
        <div class="section-heading example-heading">
          <div>
            <p class="eyebrow">
              Exemple
            </p>

            <h2>
              Le Comptoir 27
            </h2>
          </div>

          <p>
            Un concept de démonstration créé par AVARA pour illustrer
            ce que pourrait être un site de restaurant contemporain.
          </p>
        </div>

        <div class="example-browser">
          <div class="browser-bar">
            <div class="browser-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="browser-url">
              lecomptoir27.be
            </div>
          </div>

          <div class="example-page">
            <nav class="example-nav">
              <strong>
                LE COMPTOIR <span>27</span>
              </strong>

              <div>
                <span>Accueil</span>
                <span>La carte</span>
                <span>Le restaurant</span>
                <span>Galerie</span>
                <span>Contact</span>
                <b>Réserver</b>
              </div>
            </nav>

            <div class="example-hero">
              <div>
                <small>
                  Bistrot · Cuisine de saison
                </small>

                <h3>
                  La cuisine qu'on aime partager.
                </h3>

                <p>
                  Une cuisine de saison dans une ambiance chaleureuse,
                  imaginée autour du produit et du plaisir de recevoir.
                </p>

                <div class="example-actions">
                  <strong>Réserver une table</strong>
                  <span>Découvrir la carte</span>
                </div>
              </div>
            </div>

            <div class="example-bottom">
              <div>
                <small>01</small>
                <strong>La carte</strong>
                <span>Découvrir →</span>
              </div>

              <div>
                <small>02</small>
                <strong>Réserver</strong>
                <span>Choisir une table →</span>
              </div>

              <div>
                <small>03</small>
                <strong>Nous trouver</strong>
                <span>Itinéraire →</span>
              </div>
            </div>
          </div>
        </div>

        <p class="demo-note">
          Le Comptoir 27 est un concept de démonstration et ne représente
          pas un établissement client d'AVARA.
        </p>
      </div>
    </section>

    <!-- PRICING -->
    <section id="tarif" class="section pricing-section">
      <div class="restaurant-container">
        <div class="pricing-layout">
          <div class="pricing-copy">
            <p class="eyebrow">
              Tarif
            </p>

            <h2>
              Un vrai site professionnel sans budget d'agence.
            </h2>

            <p>
              Pour un restaurant qui souhaite présenter son activité,
              sa carte et faciliter les réservations, notre offre vitrine
              constitue généralement une excellente base.
            </p>
          </div>

          <div class="pricing-card">
            <div class="price-top">
              <span>
                Site restaurant
              </span>

              <div class="price">
                <small>À partir de</small>
                <strong>790 €</strong>
                <small>HTVA</small>
              </div>
            </div>

            <div class="price-features">
              <div>
                <span>✓</span>
                Jusqu'à 5 pages
              </div>

              <div>
                <span>✓</span>
                Design responsive
              </div>

              <div>
                <span>✓</span>
                Présentation du menu
              </div>

              <div>
                <span>✓</span>
                Formulaire de contact
              </div>

              <div>
                <span>✓</span>
                Lien ou intégration réservation simple
              </div>

              <div>
                <span>✓</span>
                Google Maps / itinéraire
              </div>

              <div>
                <span>✓</span>
                SEO technique de base
              </div>

              <div>
                <span>✓</span>
                Mise en ligne
              </div>

              <div>
                <span>✓</span>
                Formation de prise en main
              </div>

              <div>
                <span>✓</span>
                Réunion de corrections
              </div>
            </div>

            <div class="hosting">
              <div>
                <strong>
                  Hébergement & maintenance légère
                </strong>

                <span>
                  Pas d'abonnement mensuel obligatoire
                </span>
              </div>

              <strong>
                59 € HTVA / an
              </strong>
            </div>

            <a href="/#contact" class="button-primary full-button">
              Discuter de mon restaurant
              <span>→</span>
            </a>

            <p class="price-reassurance">
              Le tarif exact est confirmé avant le début du projet.
              Aucun supplément n'est ajouté sans votre validation préalable.
            </p>

            <p class="price-note">
              Les fonctionnalités spécifiques — réservation avancée,
              commande en ligne, multilingue ou intégrations externes —
              font l'objet d'une proposition adaptée.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="section process-section">
      <div class="restaurant-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              Comment ça marche
            </p>

            <h2>
              Vous continuez à gérer votre restaurant.
              Nous nous occupons du site.
            </h2>
          </div>

          <p>
            Un processus volontairement simple pour limiter le temps
            que vous devez consacrer au projet.
          </p>
        </div>

        <div class="process-grid">
          <article>
            <span>01</span>

            <h3>
              Discussion
            </h3>

            <p>
              Votre établissement, votre clientèle,
              votre identité et vos besoins.
            </p>
          </article>

          <article>
            <span>02</span>

            <h3>
              Contenus
            </h3>

            <p>
              Vous nous transmettez photos, carte,
              coordonnées et informations essentielles.
            </p>
          </article>

          <article>
            <span>03</span>

            <h3>
              Création
            </h3>

            <p>
              Nous concevons le site et adaptons
              l'expérience à votre établissement.
            </p>
          </article>

          <article>
            <span>04</span>

            <h3>
              Mise en ligne
            </h3>

            <p>
              Dernières corrections, domaine,
              HTTPS et publication.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section faq-section">
      <div class="restaurant-container">
        <div class="section-heading faq-heading">
          <div>
            <p class="eyebrow">
              Questions fréquentes
            </p>

            <h2>
              Les questions que se posent souvent les restaurateurs.
            </h2>
          </div>

          <p>
            L'objectif est de garder le projet simple.
            Les besoins particuliers sont identifiés avant de commencer,
            afin que vous sachiez exactement ce qui est prévu.
          </p>
        </div>

        <div class="faq-grid">
          <details class="faq-item">
            <summary>
              Puis-je conserver mon système de réservation actuel ?
              <span>+</span>
            </summary>

            <p>
              Oui. Si vous utilisez déjà Zenchef, TheFork, Resengo ou
              une autre plateforme, nous pouvons généralement intégrer
              un accès direct à votre système existant. Les intégrations
              plus avancées sont évaluées selon la solution utilisée.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Puis-je modifier ma carte et mes horaires moi-même ?
              <span>+</span>
            </summary>

            <p>
              Oui. Le site peut être configuré pour vous permettre de
              modifier facilement les contenus essentiels comme les textes,
              les horaires ou certaines informations de la carte.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Est-ce que le nom de domaine est compris ?
              <span>+</span>
            </summary>

            <p>
              Nous pouvons nous occuper de la connexion et de la configuration
              du domaine. Si vous possédez déjà votre nom de domaine, il peut
              généralement être conservé. Le coût éventuel d'achat ou de
              renouvellement du domaine reste distinct de l'offre.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Peut-on ajouter plusieurs langues ?
              <span>+</span>
            </summary>

            <p>
              Oui. Un site multilingue est tout à fait possible.
              Comme cela demande davantage de pages, de contenus et de
              configuration, cette option fait l'objet d'un tarif adapté
              au projet.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Que se passe-t-il si je souhaite ajouter des fonctionnalités plus tard ?
              <span>+</span>
            </summary>

            <p>
              Le site peut évoluer. Une nouvelle page, une galerie,
              une fonctionnalité de commande, une nouvelle intégration
              ou d'autres évolutions peuvent être ajoutées ultérieurement
              selon vos besoins.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <div class="restaurant-container">
        <div class="cta-card">
          <div>
            <p class="eyebrow light">
              Votre restaurant
            </p>

            <h2>
              Et si votre prochain client vous découvrait ici ?
            </h2>

            <p>
              Présentez-nous votre établissement et ce que vous souhaitez
              améliorer. Une première discussion suffit pour voir
              ce qu'AVARA peut vous proposer.
            </p>
          </div>

          <div class="cta-actions">
            <a href="/#contact" class="cta-white">
              Discuter de mon projet
              <span>→</span>
            </a>

            <a href="mailto:contact@avarastudio.be" class="cta-mail">
              contact@avarastudio.be
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="restaurant-footer">
    <div class="restaurant-container footer-inner">
      <a href="/" class="footer-logo">
        <span>AVARA</span>
        <small>by BLUVA</small>
      </a>

      <p>
        © 2026 AVARA by BLUVA.
      </p>

      <div>
        <a href="/">Accueil</a>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .restaurant-container {
    width: min(calc(100% - 40px), 1180px);
    margin-inline: auto;
  }

  .restaurant-header {
    position: relative;
    z-index: 20;
    padding: 20px 0;
    background: #f7f5f1;
  }

  .restaurant-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .restaurant-logo img {
    display: block;
    width: 145px;
  }

  .restaurant-nav nav {
    display: flex;
    gap: 28px;
    color: #69645f;
    font-size: 0.86rem;
  }

  .restaurant-nav nav a:hover {
    color: #171717;
  }

  .button-small,
  .button-primary,
  .button-secondary,
  .cta-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 999px;
    font-weight: 600;
  }

  .button-small {
    min-height: 42px;
    padding: 0 18px;
    background: #171717;
    color: white;
    font-size: 0.8rem;
  }

  .restaurant-hero {
    overflow: hidden;
    padding: 85px 0 105px;
    background: #f7f5f1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 65px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    padding: 8px 13px;
    border: 1px solid rgba(23, 23, 23, 0.1);
    border-radius: 999px;
    background: white;
    color: #8a624b;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .hero-content h1 {
    margin-top: 28px;
    font-family: "Manrope", sans-serif;
    font-size: clamp(3.8rem, 6vw, 6.3rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .hero-content h1 span {
    display: block;
    color: #a06f52;
  }

  .hero-text {
    max-width: 570px;
    margin-top: 28px;
    color: #6d6862;
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button-primary {
    min-height: 52px;
    padding: 0 23px;
    background: #171717;
