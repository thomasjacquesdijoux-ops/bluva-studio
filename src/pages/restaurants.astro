  .phone-links {
    display: flex;
    justify-content: space-around;
    margin-top: 15px;
    color: #8a624b;
    font-size: 0.58rem;
  }

  /* EXAMPLE */

  .example-section {
    background: #171717;
    color: white;
  }

  .example-heading > p {
    color: rgba(255, 255, 255, 0.55);
  }

  .example-browser {
