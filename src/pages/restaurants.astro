    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: #f1e4db;
    color: #9b694e;
    font-family: "Manrope", sans-serif;
    font-weight: 800;
