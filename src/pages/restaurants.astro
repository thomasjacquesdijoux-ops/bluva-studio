  .ecosystem-item p {
    margin-top: 4px;
    color: #77716b;
    font-size: 0.72rem;
  }

  .ecosystem-main p {
    color: rgba(255, 255, 255, 0.5);
  }

  .ecosystem-arrow {
    color: #9b694e;
  }

  /* MOBILE FIRST */

  .mobile-first {
    padding: 125px 0;
    overflow: hidden;
    background: #e8dfd7;
  }

  .mobile-first-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
    align-items: center;
  }

  .mobile-first-copy > p {
    margin-top: 25px;
  }

  .mobile-list {
    display: grid;
    gap: 12px;
    margin-top: 35px;
  }

  .mobile-list div {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.87rem;
  }

  .mobile-list span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    border-radius: 9px;
    background: white;
    color: #9b694e;
    font-size: 0.7rem;
