---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Création de sites vitrines & e-commerce | AVARA by BLUVA"
  description="Création de sites vitrines et e-commerce modernes pour indépendants et petites entreprises en Belgique. Sites rapides, responsive et faciles à gérer."
>
  <header class="header">
    <div class="container navbar">
      <a
        href="/"
        class="brand-logo brand-logo-image"
        aria-label="AVARA by BLUVA"
      >
        <img
          src="/images/logo-avara.png"
          alt="AVARA by BLUVA"
        />
      </a>

      <nav class="nav">
        <a href="#realisations">Projets</a>
        <a href="#services">Services</a>
        <a href="#tarifs">Tarifs</a>
        <a href="#process">Comment ça marche</a>
        <a href="#contact">Contact</a>
      </nav>

      <a href="#contact" class="button button-small">
        Parler de mon projet
      </a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            Sites vitrines & e-commerce
          </div>

          <h1>
            Des sites web qui donnent envie
            <span>d'aller plus loin.</span>
          </h1>

          <p class="hero-description">
            AVARA by BLUVA crée des sites vitrines et e-commerce modernes,
            rapides et faciles à gérer pour indépendants et petites entreprises.
          </p>

          <div class="hero-actions">
            <a href="#contact" class="button">
              Discuter de mon projet
              <span class="button-arrow">→</span>
            </a>

            <a href="#realisations" class="button button-secondary">
              Voir les projets
            </a>
          </div>

          <div class="hero-proof">
            <div>
              <strong>À partir de 790 €</strong>
              <span>HTVA · Site vitrine</span>
            </div>

            <div class="proof-separator"></div>

            <div>
              <strong>Sur devis</strong>
              <span>E-commerce</span>
            </div>

            <div class="proof-separator"></div>

            <div>
              <strong>59 € / an</strong>
              <span>Hébergement & maintenance</span>
            </div>
          </div>
        </div>

        <div class="hero-showcase">
          <div class="showcase-orbit orbit-one"></div>
          <div class="showcase-orbit orbit-two"></div>

          <div class="desktop-window">
            <div class="desktop-topbar">
              <div class="browser-controls">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="browser-url">
                atelier-verde.be
              </div>
            </div>

            <div class="website-preview">
              <div class="preview-navigation">
                <div class="preview-brand">
                  atelier<span>verde</span>
                </div>

                <div class="preview-menu">
                  <span>Accueil</span>
                  <span>Services</span>
                  <span>Projets</span>
                  <span>Contact</span>
                </div>
              </div>

              <div class="preview-hero">
                <div class="preview-copy">
                  <span class="preview-label">
                    Architecture & rénovation
                  </span>

                  <h3>
                    Des espaces pensés pour durer.
                  </h3>

                  <p>
                    Conception, rénovation et accompagnement de projets
                    résidentiels contemporains.
                  </p>

                  <div class="preview-button">
                    Découvrir nos projets
                  </div>
                </div>

                <div class="preview-photo"></div>
              </div>

              <div class="preview-services">
                <div>
                  <span>01</span>
                  <strong>Architecture</strong>
                </div>

                <div>
                  <span>02</span>
                  <strong>Rénovation</strong>
                </div>

                <div>
                  <span>03</span>
                  <strong>Conseil</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="mobile-window">
            <div class="mobile-notch"></div>

            <div class="mobile-content">
              <div class="mobile-nav">
                <strong>atelier<span>verde</span></strong>
                <span>☰</span>
              </div>

              <div class="mobile-image"></div>

              <span class="mobile-label">
                Architecture
              </span>

              <h4>
                Des espaces pensés pour durer.
              </h4>

              <div class="mobile-button">
                Nos projets
              </div>
            </div>
          </div>

          <div class="floating-card floating-card-one">
            <span class="floating-icon">✓</span>

            <div>
              <strong>Responsive</strong>
              <small>Mobile & desktop</small>
            </div>
          </div>

          <div class="floating-card floating-card-two">
            <span class="floating-icon">✦</span>

            <div>
              <strong>Sur mesure</strong>
              <small>Selon votre activité</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="highlights">
      <div class="container highlight-grid">
        <div class="highlight">
          <strong>790 €</strong>
          <span>HTVA · à partir de</span>
          <p>Site vitrine jusqu'à 5 pages</p>
        </div>

        <div class="highlight">
          <strong>100%</strong>
          <span>responsive</span>
          <p>Ordinateur, tablette et mobile</p>
        </div>

        <div class="highlight">
          <strong>CMS</strong>
          <span>simple</span>
          <p>Vos contenus restent modifiables</p>
        </div>

        <div class="highlight">
          <strong>Webshop</strong>
          <span>sur devis</span>
          <p>E-commerce adapté au projet</p>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="section services-section">
      <div class="container">
        <div class="services-heading">
          <div>
            <p class="eyebrow">
              Services
            </p>

            <h2>
              Le bon site pour le bon projet.
            </h2>
          </div>

          <p>
            Une présence simple pour présenter votre activité ou une boutique
            complète pour vendre en ligne : nous adaptons la solution à votre
            besoin.
          </p>
        </div>

        <div class="services-grid">
          <article class="service-card service-featured">
            <div class="service-top">
              <span class="service-number">01</span>
              <span class="service-tag">Offre principale</span>
            </div>

            <div class="service-icon">↗</div>

            <h3>Site vitrine</h3>

            <p>
              Une présence professionnelle en ligne pour présenter votre
              activité, vos services et faciliter la prise de contact.
            </p>

            <ul class="service-list">
              <li>Jusqu'à 5 pages</li>
              <li>Design responsive</li>
              <li>CMS simple</li>
              <li>SEO technique de base</li>
              <li>Formulaire de contact</li>
              <li>Mise en ligne complète</li>
            </ul>

            <div class="service-price-row">
              <div>
                <span>À partir de</span>
                <strong>790 € HTVA</strong>
              </div>

              <a href="#tarifs" class="service-link">
                Voir l'offre →
              </a>
            </div>
          </article>

          <article class="service-card service-commerce">
            <div class="service-top">
              <span class="service-number">02</span>
              <span class="service-tag neutral">Sur mesure</span>
            </div>

            <div class="service-icon commerce-icon">◇</div>

            <h3>E-commerce</h3>

            <p>
              Une boutique en ligne pensée pour votre activité,
              votre catalogue et votre manière de travailler.
            </p>

            <ul class="service-list">
              <li>Catalogue produits</li>
              <li>Paiement en ligne</li>
              <li>Livraison ou retrait</li>
              <li>Gestion du contenu</li>
              <li>Responsive</li>
              <li>Intégrations selon le projet</li>
            </ul>

            <div class="service-price-row">
              <div>
                <span>Selon les besoins</span>
                <strong>Sur devis</strong>
              </div>

              <a href="#contact" class="service-link">
                Discuter du projet →
              </a>
            </div>
          </article>

          <article class="service-card service-extra">
            <div class="service-top">
              <span class="service-number">03</span>
            </div>

            <div class="service-icon">+</div>

            <h3>Évolutions & fonctionnalités</h3>

            <p>
              Votre site peut évoluer après sa mise en ligne :
              nouvelles pages, formulaires, sections ou intégrations
              spécifiques.
            </p>

            <div class="extra-features">
              <span>Pages supplémentaires</span>
              <span>Refonte</span>
              <span>Automatisations</span>
              <span>Intégrations</span>
            </div>

            <div class="service-price-row">
              <div>
                <span>Interventions</span>
                <strong>65 € HTVA / h</strong>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- WHY AVARA -->
    <section class="section why-avara">
      <div class="container">
        <div class="why-avara-heading">
          <div>
            <p class="eyebrow">
              Pourquoi AVARA ?
            </p>

            <h2>
              Un site professionnel,
              sans projet interminable.
            </h2>
          </div>

          <p>
            Une approche simple pour les indépendants et petites entreprises :
            un interlocuteur direct, un prix clair et un site conçu pour être
            utile au quotidien.
          </p>
        </div>

        <div class="why-avara-grid">
          <article class="why-avara-card">
            <span class="why-avara-number">01</span>

            <h3>Un interlocuteur unique</h3>

            <p>
              Vous échangez directement avec la personne qui conçoit et
              développe votre site, de la première discussion à la mise en
              ligne.
            </p>
          </article>

          <article class="why-avara-card">
            <span class="why-avara-number">02</span>

            <h3>Un prix clair</h3>

            <p>
              Une offre simple, sans structure d'agence lourde ni
              multiplication des intermédiaires.
            </p>
          </article>

          <article class="why-avara-card">
            <span class="why-avara-number">03</span>

            <h3>Vous gardez la main</h3>

            <p>
              Les contenus essentiels de votre site peuvent être modifiés
              facilement sans devoir nous contacter à chaque changement.
            </p>
          </article>

          <article class="why-avara-card">
            <span class="why-avara-number">04</span>

            <h3>Rapide et performant</h3>

            <p>
              Des sites légers, responsive et pensés pour offrir une expérience
              fluide sur ordinateur comme sur mobile.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- PROJETS -->
    <section id="realisations" class="section portfolio-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              Projets & réalisations
            </p>

            <h2>
              Quelques univers que nous pouvons créer.
            </h2>
          </div>

          <p class="section-intro">
            Des concepts réalisés pour illustrer différents styles, secteurs
            et fonctionnalités. Les premières réalisations clients viendront
            progressivement compléter cette sélection.
          </p>
        </div>

        <div class="portfolio-grid">
          <!-- RESTAURANT -->
          <article class="project-card project-large">
            <div class="project-preview restaurant-showcase-preview">
              <div class="restaurant-browser">
                <div class="restaurant-browser-bar">
                  <div class="browser-controls">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <div class="restaurant-browser-url">
                    lecomptoir27.be
                  </div>
                </div>

                <div class="restaurant-showcase-site">
                  <div class="restaurant-showcase-nav">
                    <div class="restaurant-logo">
                      LE COMPTOIR <span>27</span>
                    </div>

                    <div class="restaurant-showcase-menu">
                      <span>La carte</span>
                      <span>Le restaurant</span>
                      <span>Galerie</span>
                      <span>Contact</span>
                      <strong>Réserver</strong>
                    </div>
                  </div>

                  <div class="restaurant-showcase-hero">
                    <div class="restaurant-showcase-content">
                      <span class="restaurant-showcase-kicker">
                        Bistrot · Cuisine de saison
                      </span>

                      <h3>
                        La cuisine qu'on aime partager.
                      </h3>

                      <p>
                        Des produits de saison, une cuisine généreuse
                        et une table pensée pour les bons moments.
                      </p>

                      <div class="restaurant-showcase-actions">
                        <span class="restaurant-primary-action">
                          Réserver une table
                        </span>

                        <span class="restaurant-secondary-action">
                          Découvrir la carte
                        </span>
                      </div>
                    </div>

                    <div class="restaurant-booking-card">
                      <span class="booking-label">
                        Réservation
                      </span>

                      <strong>
                        Ouvert du mardi au samedi
                      </strong>

                      <p>
                        12:00 — 14:30 · 18:30 — 22:30
                      </p>

                      <span class="booking-chip">
                        Nalinnes · Sur réservation
                      </span>
                    </div>
                  </div>

                  <div class="restaurant-showcase-bottom">
                    <div>
                      <span>01</span>
                      <strong>Suggestions</strong>
                      <small>Produits de saison</small>
                    </div>

                    <div>
                      <span>02</span>
                      <strong>Cocktails</strong>
                      <small>Classiques & créations</small>
                    </div>

                    <div>
                      <span>03</span>
                      <strong>Desserts</strong>
                      <small>Faits maison</small>
                    </div>

                    <div>
                      <span>Mar — Sam</span>
                      <strong>12:00 — 14:30</strong>
                      <small>18:30 — 22:30</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="project-info">
              <div>
                <span class="project-type">
                  Restaurant / réservation
                </span>

                <h3>
                  Le Comptoir 27
                </h3>

                <a href="/restaurants/" class="project-link">
                  Découvrir notre offre pour les restaurants →
                </a>
              </div>

              <p>
                Un site immersif pensé pour donner envie de venir à table :
                carte, univers du restaurant, réservation et informations
                pratiques accessibles immédiatement.
              </p>
            </div>
          </article>

          <!-- ARCHITECTURE -->
          <article class="project-card">
            <div class="project-preview architecture-preview">
              <div class="project-browser">
                <div class="mini-browser-bar">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="architecture-site">
                  <div class="architecture-top">
                    <strong>
                      atelier verde
                    </strong>

                    <div>
                      <span>Projets</span>
                      <span>Studio</span>
                      <span>Contact</span>
                    </div>
                  </div>

                  <div class="architecture-main">
                    <div>
                      <small>
                        Architecture & rénovation
                      </small>

                      <h3>
                        Habiter autrement.
                      </h3>

                      <p>
                        Des espaces contemporains pensés autour de la lumière,
                        des matières et de votre manière de vivre.
                      </p>

                      <span class="fake-link">
                        Découvrir les projets →
                      </span>
                    </div>

                    <div class="architecture-image">
                      <div class="architecture-image-label">
                        <span>Projet résidentiel</span>
                        <strong>Maison R.</strong>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="project-info vertical">
              <div>
                <span class="project-type">
                  Site vitrine
                </span>

                <h3>
                  Atelier Verde
                </h3>
              </div>

              <p>
                Une identité éditoriale minimaliste et premium pensée
                pour une activité d'architecture et de rénovation.
              </p>
            </div>
          </article>

          <!-- ECOMMERCE -->
          <article class="project-card">
            <div class="project-preview shop-preview">
              <div class="shop-site">
                <div class="shop-nav">
                  <strong>
                    Éclat.
                  </strong>

                  <div>
                    <span>Boutique</span>
                    <span>Collections</span>
                    <span>Panier · 2</span>
                  </div>
                </div>

                <div class="shop-main">
                  <div class="shop-copy">
                    <span>
                      Nouvelle collection
                    </span>

                    <h3>
                      Des bijoux faits pour durer.
                    </h3>

                    <p>
                      Des pièces minimalistes sélectionnées
                      pour accompagner le quotidien.
                    </p>

                    <div class="shop-button">
                      Voir la collection
                    </div>
                  </div>

                  <div class="shop-image">
                    <div class="shop-image-label">
                      <span>
                        Collection 2026
                      </span>

                      <strong>
                        Éclat.
                      </strong>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="project-info vertical">
              <div>
                <span class="project-type">
                  E-commerce
                </span>

                <h3>
                  Éclat
                </h3>
              </div>

              <p>
                Un concept de boutique en ligne conçu autour d'un catalogue
                de bijoux et d'une expérience d'achat simple.
              </p>
            </div>
          </article>
        </div>

        <p class="portfolio-note">
          Concepts de démonstration réalisés pour illustrer différents styles,
          secteurs et fonctionnalités. Ils ne représentent pas de faux projets
          clients.
        </p>
      </div>
    </section>

    <!-- TARIFS -->
    <section id="tarifs" class="section offer-section">
      <div class="container">
        <div class="offer-heading">
          <div>
            <p class="eyebrow">
              Tarifs
            </p>

            <h2>
              Une offre simple,
              sans coûts inutiles.
            </h2>
          </div>

          <p>
            Pour les sites vitrines, nous avons choisi une formule claire
            avec un prix de départ connu dès le début.
          </p>
        </div>

        <div class="offer-layout">
          <div class="offer-card">
            <div class="offer-top">
              <div>
                <span class="offer-label">
                  Site vitrine
                </span>

                <h3>
                  L'essentiel pour être visible et crédible en ligne.
                </h3>
              </div>

              <div class="offer-price">
                <span>
                  À partir de
                </span>

                <strong>
                  790 €
                </strong>

                <small>
                  HTVA
                </small>
              </div>
            </div>

            <div class="offer-features">
              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>Jusqu'à 5 pages</strong>
                  <p>Structure adaptée à votre activité.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>Design responsive</strong>
                  <p>Ordinateur, tablette et smartphone.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>CMS simple</strong>
                  <p>Modifiez les contenus essentiels vous-même.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>SEO technique de base</strong>
                  <p>Structure propre, titres, sitemap et métadonnées.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>Formulaire de contact</strong>
                  <p>Pour faciliter les demandes de vos visiteurs.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>Réunion de validation</strong>
                  <p>Dernières corrections avant publication.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>Mise en ligne complète</strong>
                  <p>Domaine, hébergement et HTTPS.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>

                <div>
                  <strong>Formation rapide</strong>
                  <p>Prise en main des modifications courantes.</p>
                </div>
              </div>
            </div>

            <div class="offer-footer">
              <div class="annual-plan">
                <span class="annual-icon">
                  ↻
                </span>

                <div>
                  <strong>
                    Hébergement & maintenance légère
                  </strong>

                  <p>
                    Hébergement, SSL et support technique léger.
                  </p>
                </div>

                <div class="annual-price">
                  <strong>
                    59 €
                  </strong>

                  <span>
                    HTVA / an
                  </span>
                </div>
              </div>

              <a href="#contact" class="button offer-button">
                Discuter de mon projet
                <span class="button-arrow">→</span>
              </a>
            </div>
          </div>

          <aside class="offer-side">
            <div class="offer-side-card">
              <span class="side-number">
                01
              </span>

              <h3>
                Pas d'abonnement mensuel obligatoire.
              </h3>

              <p>
                Pour un site vitrine standard, l'hébergement et la maintenance
                légère sont proposés à seulement 59 € HTVA par an.
              </p>
            </div>

            <div class="offer-side-card dark">
              <span class="side-number">
                02
              </span>

              <h3>
                Votre contenu reste modifiable.
              </h3>

              <p>
                Textes, photos, horaires et coordonnées peuvent être gérés
                via une interface simple.
              </p>
            </div>

            <div class="offer-side-card accent-card">
              <span class="side-number">
                03
              </span>

              <h3>
                Et pour un e-commerce ?
              </h3>

              <p>
                Le prix dépend du catalogue, des paiements,
                des livraisons et des intégrations nécessaires.
              </p>

              <span class="side-price">
                Sur devis
              </span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section about-avara">
      <div class="container">
        <div class="about-avara-card">
          <div class="about-avara-label">
            <span>AVARA</span>
            <small>by BLUVA</small>
          </div>

          <div class="about-avara-content">
            <p class="eyebrow">
              Un accompagnement direct
            </p>

            <h2>
              Derrière chaque projet,
              un interlocuteur unique.
            </h2>

            <p>
              Je conçois et développe personnellement chaque projet,
              de la première discussion jusqu'à la mise en ligne.
              L'objectif est simple : proposer aux indépendants et petites
              entreprises un site professionnel sans les coûts et la
              complexité d'une grosse agence.
            </p>

            <p class="about-signature">
              Thomas — AVARA by BLUVA
            </p>

            <a href="#contact" class="button">
              Parler de mon projet
              <span class="button-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="section process-section">
      <div class="container">
        <div class="process-heading">
          <div>
            <p class="eyebrow">
              Comment ça marche
            </p>

            <h2>
              De votre idée à la mise en ligne,
              simplement.
            </h2>
          </div>

          <p>
            Un processus clair pour cadrer le projet,
            valider le résultat et éviter les mauvaises surprises.
          </p>
        </div>

        <div class="process-grid">
          <article class="process-card">
            <span class="process-number">
              01
            </span>

            <div class="process-icon">
              ↗
            </div>

            <h3>
              Votre projet
            </h3>

            <p>
              Nous échangeons sur votre activité, vos objectifs,
              vos contenus et le style recherché.
            </p>

            <span class="process-detail">
              Brief & cahier des charges
            </span>
          </article>

          <article class="process-card featured">
            <span class="process-number">
              02
            </span>

            <div class="process-icon">
              ✦
            </div>

            <h3>
              Création
            </h3>

            <p>
              Nous concevons et développons le site selon la structure
              et les besoins définis ensemble.
            </p>

            <span class="process-detail">
              Design & développement
            </span>
          </article>

          <article class="process-card">
            <span class="process-number">
              03
            </span>

            <div class="process-icon">
              ✓
            </div>

            <h3>
              Validation
            </h3>

            <p>
              Nous parcourons le site ensemble et réalisons
              les dernières corrections avant publication.
            </p>

            <span class="process-detail">
              Réunion de 30 à 60 min
            </span>
          </article>

          <article class="process-card">
            <span class="process-number">
              04
            </span>

            <div class="process-icon">
              ↑
            </div>

            <h3>
              Mise en ligne
            </h3>

            <p>
              Domaine, hébergement, HTTPS et derniers contrôles :
              votre site est prêt à accueillir ses visiteurs.
            </p>

            <span class="process-detail">
              Publication
            </span>
          </article>
        </div>

        <div class="process-bottom">
          <div>
            <span class="process-bottom-label">
              Après la mise en ligne
            </span>

            <h3>
              Votre site peut continuer à évoluer.
            </h3>

            <p>
              Modifiez les contenus simples vous-même ou faites appel
              à AVARA by BLUVA lorsque vous souhaitez ajouter quelque chose.
            </p>
          </div>

          <a href="#contact" class="button">
            Démarrer mon projet
            <span class="button-arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact-section">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-content">
            <p class="eyebrow light-eyebrow">
              Votre projet
            </p>

            <h2>
              Parlons de votre
              <span>futur site.</span>
            </h2>

            <p class="contact-intro">
              Site vitrine, boutique en ligne ou évolution d'un site existant :
              expliquez-nous votre projet en quelques lignes.
            </p>

            <p class="contact-reassurance">
              Une idée, même encore imprécise ? Écrivez-nous.
              Nous vous répondrons généralement sous 1 jour ouvrable.
            </p>

            <div class="contact-points">
              <div class="contact-point">
                <span class="contact-point-icon">
                  01
                </span>

                <div>
                  <strong>
                    Une première discussion
                  </strong>

                  <p>
                    Nous vérifions ensemble ce dont votre projet a réellement
                    besoin.
                  </p>
                </div>
              </div>

              <div class="contact-point">
                <span class="contact-point-icon">
                  02
                </span>

                <div>
                  <strong>
                    Une proposition adaptée
                  </strong>

                  <p>
                    Le périmètre et le tarif sont définis avant de commencer.
                  </p>
                </div>
              </div>

              <div class="contact-point">
                <span class="contact-point-icon">
                  03
                </span>

                <div>
                  <strong>
                    Aucun engagement à ce stade
                  </strong>

                  <p>
                    Envoyer une demande permet simplement de démarrer la
                    discussion.
                  </p>
                </div>
              </div>
            </div>

            <div class="contact-mini-card">
              <span class="contact-mini-dot"></span>

              <div>
                <strong>
                  Site vitrine à partir de 790 € HTVA
                </strong>

                <p>
                  E-commerce et besoins spécifiques sur devis.
                </p>
              </div>
            </div>
          </div>

          <div class="contact-form-card">
            <div class="contact-form-heading">
              <span>
                Demande de projet
              </span>

              <h3>
                Parlez-nous de votre activité.
              </h3>

              <p>
                Quelques informations suffisent pour commencer.
              </p>
            </div>

            <form
              name="demande-projet"
              method="POST"
              action="/merci/"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              class="contact-form"
            >
              <input
                type="hidden"
                name="form-name"
                value="demande-projet"
              />

              <p class="hidden-field">
                <label>
                  Ne pas remplir :
                  <input name="bot-field" />
                </label>
              </p>

              <div class="form-row">
                <div class="form-group">
                  <label for="name">
                    Nom *
                  </label>

                  <input
                    id="name"
                    type="text"
                    name="name"
                    placeholder="Jean Dupont"
                    autocomplete="name"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="company">
                    Entreprise
                  </label>

                  <input
                    id="company"
                    type="text"
                    name="company"
                    placeholder="Votre entreprise"
                    autocomplete="organization"
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="email">
                    E-mail *
                  </label>

                  <input
                    id="email"
                    type="email"
                    name="email"
                    placeholder="vous@entreprise.be"
                    autocomplete="email"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="phone">
                    Téléphone
                  </label>

                  <input
                    id="phone"
                    type="tel"
                    name="phone"
                    placeholder="+32 ..."
                    autocomplete="tel"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="project-type">
                  Type de projet *
                </label>

                <div class="select-wrapper">
                  <select
                    id="project-type"
                    name="project-type"
                    required
                  >
                    <option value="">
                      Sélectionnez une option
                    </option>

                    <option value="site-vitrine">
                      Site vitrine
                    </option>

                    <option value="ecommerce">
                      E-commerce
                    </option>

                    <option value="refonte">
                      Refonte d'un site existant
                    </option>

                    <option value="evolution">
                      Modification / nouvelle fonctionnalité
                    </option>

                    <option value="autre">
                      Autre projet
                    </option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="message">
                  Parlez-nous de votre projet *
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Présentez brièvement votre activité, ce dont vous avez besoin et vos éventuelles idées..."
                  required
                ></textarea>
              </div>

              <label class="form-consent">
                <input
                  type="checkbox"
                  name="privacy-acknowledgement"
                  value="yes"
                  required
                />

                <span>
                  J'ai pris connaissance de la
                  <a href="/confidentialite/" target="_blank">
                    politique de confidentialité
                  </a>.
                </span>
              </label>

              <button
                type="submit"
                class="button contact-submit"
              >
                Envoyer ma demande
                <span class="button-arrow">→</span>
              </button>

              <p class="form-note">
                Aucun paiement ni engagement à ce stade.
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-content">
      <a href="/" class="footer-brand">
        <span>AVARA</span>
        <small>by BLUVA</small>
      </a>

      <p>
        © 2026 AVARA by BLUVA. Tous droits réservés.
      </p>

      <div class="footer-links">
        <a href="/mentions-legales/">
          Mentions légales
        </a>

        <a href="/confidentialite/">
          Confidentialité
        </a>
      </div>
    </div>
  </footer>
</Layout>