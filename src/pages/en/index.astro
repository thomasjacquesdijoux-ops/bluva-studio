---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Business websites & e-commerce | AVARA by BLUVA"
  description="Modern business websites and e-commerce solutions for freelancers and small businesses in Belgium. Fast, responsive and easy to manage."
>
  <header class="header">
    <div class="container navbar">
      <a
        href="/en/"
        class="brand-logo brand-logo-image"
        aria-label="AVARA by BLUVA"
      >
        <img
          src="/images/logo-avara.png"
          alt="AVARA by BLUVA"
        />
      </a>

      <nav class="nav">
        <a href="#projects">Projects</a>
        <a href="#services">Services</a>
        <a href="#pricing">Pricing</a>
        <a href="#process">How it works</a>
        <a href="#contact">Contact</a>
      </nav>

      <a href="#contact" class="button button-small">
        Discuss my project
      </a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            Business websites & e-commerce
          </div>

          <h1>
            Websites that make people want
            <span>to take the next step.</span>
          </h1>

          <p class="hero-description">
            AVARA by BLUVA creates modern, fast and easy-to-manage websites
            for freelancers, local businesses and small companies.
          </p>

          <div class="hero-actions">
            <a href="#contact" class="button">
              Discuss my project
              <span class="button-arrow">→</span>
            </a>

            <a href="#projects" class="button button-secondary">
              View projects
            </a>
          </div>

          <div class="hero-proof">
            <div>
              <strong>From €790</strong>
              <span>Excl. VAT · Business website</span>
            </div>

            <div class="proof-separator"></div>

            <div>
              <strong>Custom quote</strong>
              <span>E-commerce</span>
            </div>

            <div class="proof-separator"></div>

            <div>
              <strong>€59 / year</strong>
              <span>Hosting & light maintenance</span>
            </div>
          </div>
        </div>

        <div class="hero-showcase">
          <div class="showcase-orbit orbit-one"></div>
          <div class="showcase-orbit orbit-two"></div>

          <div class="desktop-window">
            <div class="desktop-topbar">
              <div class="browser-controls">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="browser-url">
                atelier-verde.be
              </div>
            </div>

            <div class="website-preview">
              <div class="preview-navigation">
                <div class="preview-brand">
                  atelier<span>verde</span>
                </div>

                <div class="preview-menu">
                  <span>Home</span>
                  <span>Services</span>
                  <span>Projects</span>
                  <span>Contact</span>
                </div>
              </div>

              <div class="preview-hero">
                <div class="preview-copy">
                  <span class="preview-label">
                    Architecture & renovation
                  </span>

                  <h3>
                    Spaces designed to last.
                  </h3>

                  <p>
                    Design, renovation and support for contemporary
                    residential projects.
                  </p>

                  <div class="preview-button">
                    Explore our projects
                  </div>
                </div>

                <div class="preview-photo"></div>
              </div>

              <div class="preview-services">
                <div>
                  <span>01</span>
                  <strong>Architecture</strong>
                </div>

                <div>
                  <span>02</span>
                  <strong>Renovation</strong>
                </div>

                <div>
                  <span>03</span>
                  <strong>Consulting</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="mobile-window">
            <div class="mobile-notch"></div>

            <div class="mobile-content">
              <div class="mobile-nav">
                <strong>atelier<span>verde</span></strong>
                <span>☰</span>
              </div>

              <div class="mobile-image"></div>

              <span class="mobile-label">
                Architecture
              </span>

              <h4>
                Spaces designed to last.
              </h4>

              <div class="mobile-button">
                Our projects
              </div>
            </div>
          </div>

          <div class="floating-card floating-card-one">
            <span class="floating-icon">✓</span>

            <div>
              <strong>Responsive</strong>
              <small>Mobile & desktop</small>
            </div>
          </div>

          <div class="floating-card floating-card-two">
            <span class="floating-icon">✦</span>

            <div>
              <strong>Tailored</strong>
              <small>To your business</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="highlights">
      <div class="container highlight-grid">
        <div class="highlight">
          <strong>€790</strong>
          <span>excl. VAT · from</span>
          <p>Business website up to 5 pages</p>
        </div>

        <div class="highlight">
          <strong>100%</strong>
          <span>responsive</span>
          <p>Desktop, tablet and mobile</p>
        </div>

        <div class="highlight">
          <strong>CMS</strong>
          <span>simple</span>
          <p>Keep control of your content</p>
        </div>

        <div class="highlight">
          <strong>Webshop</strong>
          <span>custom quote</span>
          <p>E-commerce tailored to your project</p>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="section services-section">
      <div class="container">
        <div class="services-heading">
          <div>
            <p class="eyebrow">Services</p>

            <h2>
              The right website for the right project.
            </h2>
          </div>

          <p>
            Whether you need a simple online presence or a complete online
            store, the solution is adapted to your business and your goals.
          </p>
        </div>

        <div class="services-grid">
          <article class="service-card service-featured">
            <div class="service-top">
              <span class="service-number">01</span>
              <span class="service-tag">Core offer</span>
            </div>

            <div class="service-icon">↗</div>

            <h3>Business website</h3>

            <p>
              A professional online presence to present your business,
              your services and make it easy for customers to contact you.
            </p>

            <ul class="service-list">
              <li>Up to 5 pages</li>
              <li>Responsive design</li>
              <li>Simple CMS</li>
              <li>Basic technical SEO</li>
              <li>Contact form</li>
              <li>Complete launch</li>
            </ul>

            <div class="service-price-row">
              <div>
                <span>From</span>
                <strong>€790 excl. VAT</strong>
              </div>

              <a href="#pricing" class="service-link">
                View the offer →
              </a>
            </div>
          </article>

          <article class="service-card service-commerce">
            <div class="service-top">
              <span class="service-number">02</span>
              <span class="service-tag neutral">Tailored</span>
            </div>

            <div class="service-icon commerce-icon">◇</div>

            <h3>E-commerce</h3>

            <p>
              An online store designed around your products,
              your customers and the way you work.
            </p>

            <ul class="service-list">
              <li>Product catalogue</li>
              <li>Online payments</li>
              <li>Delivery or pickup</li>
              <li>Content management</li>
              <li>Responsive design</li>
              <li>Integrations when needed</li>
            </ul>

            <div class="service-price-row">
              <div>
                <span>Depending on your needs</span>
                <strong>Custom quote</strong>
              </div>

              <a href="#contact" class="service-link">
                Discuss the project →
              </a>
            </div>
          </article>

          <article class="service-card service-extra">
            <div class="service-top">
              <span class="service-number">03</span>
            </div>

            <div class="service-icon">+</div>

            <h3>Improvements & features</h3>

            <p>
              Your website can evolve after launch with new pages,
              forms, sections, automations or specific integrations.
            </p>

            <div class="extra-features">
              <span>Additional pages</span>
              <span>Redesign</span>
              <span>Automations</span>
              <span>Integrations</span>
            </div>

            <div class="service-price-row">
              <div>
                <span>Additional work</span>
                <strong>€65 excl. VAT / h</strong>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- WHY AVARA -->
    <section class="section why-avara">
      <div class="container">
        <div class="why-avara-heading">
          <div>
            <p class="eyebrow">
              Why AVARA?
            </p>

            <h2>
              A professional website,
              without an endless project.
            </h2>
          </div>

          <p>
            A straightforward approach for freelancers and small businesses:
            direct communication, clear pricing and a website designed
            to be useful every day.
          </p>
        </div>

        <div class="why-avara-grid">
          <article class="why-avara-card">
            <span class="why-avara-number">01</span>

            <h3>One point of contact</h3>

            <p>
              You work directly with the person designing and developing
              your website, from the first discussion through to launch.
            </p>
          </article>

          <article class="why-avara-card">
            <span class="why-avara-number">02</span>

            <h3>Clear pricing</h3>

            <p>
              A simple offer without a heavy agency structure
              or layers of intermediaries.
            </p>
          </article>

          <article class="why-avara-card">
            <span class="why-avara-number">03</span>

            <h3>You stay in control</h3>

            <p>
              Essential content can be updated easily without needing
              to contact us for every small change.
            </p>
          </article>

          <article class="why-avara-card">
            <span class="why-avara-number">04</span>

            <h3>Fast and efficient</h3>

            <p>
              Lightweight, responsive websites designed for a smooth
              experience on desktop and mobile.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="section portfolio-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              Projects & concepts
            </p>

            <h2>
              A few of the worlds we can create.
            </h2>
          </div>

          <p class="section-intro">
            Concepts created to demonstrate different styles, industries and
            features. Client projects will gradually be added to this selection.
          </p>
        </div>

        <div class="portfolio-grid">
          <!-- RESTAURANT -->
          <article class="project-card project-large">
            <div class="project-preview restaurant-showcase-preview">
              <div class="restaurant-browser">
                <div class="restaurant-browser-bar">
                  <div class="browser-controls">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <div class="restaurant-browser-url">
                    lecomptoir27.be
                  </div>
                </div>

                <div class="restaurant-showcase-site">
                  <div class="restaurant-showcase-nav">
                    <div class="restaurant-logo">
                      LE COMPTOIR <span>27</span>
                    </div>

                    <div class="restaurant-showcase-menu">
                      <span>Menu</span>
                      <span>Restaurant</span>
                      <span>Gallery</span>
                      <span>Contact</span>
                      <strong>Book</strong>
                    </div>
                  </div>

                  <div class="restaurant-showcase-hero">
                    <div class="restaurant-showcase-content">
                      <span class="restaurant-showcase-kicker">
                        Bistro · Seasonal cuisine
                      </span>

                      <h3>
                        Food made to be shared.
                      </h3>

                      <p>
                        Seasonal produce, generous cooking and a place
                        designed for memorable moments.
                      </p>

                      <div class="restaurant-showcase-actions">
                        <span class="restaurant-primary-action">
                          Book a table
                        </span>

                        <span class="restaurant-secondary-action">
                          View the menu
                        </span>
                      </div>
                    </div>

                    <div class="restaurant-booking-card">
                      <span class="booking-label">
                        Reservations
                      </span>

                      <strong>
                        Open Tuesday to Saturday
                      </strong>

                      <p>
                        12:00 — 14:30 · 18:30 — 22:30
                      </p>

                      <span class="booking-chip">
                        Nalinnes · Booking recommended
                      </span>
                    </div>
                  </div>

                  <div class="restaurant-showcase-bottom">
                    <div>
                      <span>01</span>
                      <strong>Seasonal picks</strong>
                      <small>Fresh produce</small>
                    </div>

                    <div>
                      <span>02</span>
                      <strong>Cocktails</strong>
                      <small>Classics & creations</small>
                    </div>

                    <div>
                      <span>03</span>
                      <strong>Desserts</strong>
                      <small>Homemade</small>
                    </div>

                    <div>
                      <span>Tue — Sat</span>
                      <strong>12:00 — 14:30</strong>
                      <small>18:30 — 22:30</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="project-info">
              <div>
                <span class="project-type">
                  Restaurant / booking
                </span>

                <h3>
                  Le Comptoir 27
                </h3>

                <a href="/en/restaurants/" class="project-link">
                  Discover our restaurant website offer →
                </a>
              </div>

              <p>
                An immersive website designed to make people want to visit:
                menu, restaurant atmosphere, booking and practical information
                are immediately accessible.
              </p>
            </div>
          </article>

          <!-- ARCHITECTURE -->
          <article class="project-card">
            <div class="project-preview architecture-preview">
              <div class="project-browser">
                <div class="mini-browser-bar">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="architecture-site">
                  <div class="architecture-top">
                    <strong>atelier verde</strong>

                    <div>
                      <span>Projects</span>
                      <span>Studio</span>
                      <span>Contact</span>
                    </div>
                  </div>

                  <div class="architecture-main">
                    <div>
                      <small>Architecture & renovation</small>

                      <h3>
                        A different way to live.
                      </h3>

                      <p>
                        Contemporary spaces shaped around light,
                        materials and the way you live.
                      </p>

                      <span class="fake-link">
                        Explore the projects →
                      </span>
                    </div>

                    <div class="architecture-image">
                      <div class="architecture-image-label">
                        <span>Residential project</span>
                        <strong>Maison R.</strong>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="project-info vertical">
              <div>
                <span class="project-type">
                  Business website
                </span>

                <h3>
                  Atelier Verde
                </h3>
              </div>

              <p>
                A minimal, premium editorial identity designed
                for an architecture and renovation studio.
              </p>
            </div>
          </article>

          <!-- ECOMMERCE -->
          <article class="project-card">
            <div class="project-preview shop-preview">
              <div class="shop-site">
                <div class="shop-nav">
                  <strong>Éclat.</strong>

                  <div>
                    <span>Shop</span>
                    <span>Collections</span>
                    <span>Cart · 2</span>
                  </div>
                </div>

                <div class="shop-main">
                  <div class="shop-copy">
                    <span>New collection</span>

                    <h3>
                      Jewellery designed to last.
                    </h3>

                    <p>
                      Minimal pieces selected to be worn every day.
                    </p>

                    <div class="shop-button">
                      View the collection
                    </div>
                  </div>

                  <div class="shop-image">
                    <div class="shop-image-label">
                      <span>Collection 2026</span>
                      <strong>Éclat.</strong>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="project-info vertical">
              <div>
                <span class="project-type">
                  E-commerce
                </span>

                <h3>
                  Éclat
                </h3>
              </div>

              <p>
                An online store concept built around a jewellery catalogue
                and a simple shopping experience.
              </p>
            </div>
          </article>
        </div>

        <p class="portfolio-note">
          Demonstration concepts created to illustrate different styles,
          industries and features. They are not presented as client work.
        </p>
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="section offer-section">
      <div class="container">
        <div class="offer-heading">
          <div>
            <p class="eyebrow">
              Pricing
            </p>

            <h2>
              A simple offer,
              without unnecessary costs.
            </h2>
          </div>

          <p>
            For business websites, we use a clear starting package
            so you know the budget from the beginning.
          </p>
        </div>

        <div class="offer-layout">
          <div class="offer-card">
            <div class="offer-top">
              <div>
                <span class="offer-label">
                  Business website
                </span>

                <h3>
                  Everything you need to look professional and credible online.
                </h3>
              </div>

              <div class="offer-price">
                <span>From</span>
                <strong>€790</strong>
                <small>excl. VAT</small>
              </div>
            </div>

            <div class="offer-features">
              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Up to 5 pages</strong>
                  <p>A structure tailored to your business.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Responsive design</strong>
                  <p>Desktop, tablet and smartphone.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Simple CMS</strong>
                  <p>Update essential content yourself.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Basic technical SEO</strong>
                  <p>Clean structure, titles, sitemap and metadata.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Contact form</strong>
                  <p>Make it easy for visitors to reach you.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Review meeting</strong>
                  <p>Final corrections before launch.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Complete launch</strong>
                  <p>Domain connection, hosting and HTTPS.</p>
                </div>
              </div>

              <div class="offer-feature">
                <span class="check">✓</span>
                <div>
                  <strong>Quick training</strong>
                  <p>Learn how to handle everyday updates.</p>
                </div>
              </div>
            </div>

            <div class="offer-footer">
              <div class="annual-plan">
                <span class="annual-icon">↻</span>

                <div>
                  <strong>Hosting & light maintenance</strong>
                  <p>Hosting, SSL and light technical support.</p>
                </div>

                <div class="annual-price">
                  <strong>€59</strong>
                  <span>excl. VAT / year</span>
                </div>
              </div>

              <a href="#contact" class="button offer-button">
                Discuss my project
                <span class="button-arrow">→</span>
              </a>
            </div>
          </div>

          <aside class="offer-side">
            <div class="offer-side-card">
              <span class="side-number">01</span>

              <h3>
                No mandatory monthly subscription.
              </h3>

              <p>
                For a standard business website, hosting and light maintenance
                start at only €59 excl. VAT per year.
              </p>
            </div>

            <div class="offer-side-card dark">
              <span class="side-number">02</span>

              <h3>
                Your content stays editable.
              </h3>

              <p>
                Text, photos, opening hours and contact details can be managed
                through a simple interface.
              </p>
            </div>

            <div class="offer-side-card accent-card">
              <span class="side-number">03</span>

              <h3>
                Need e-commerce?
              </h3>

              <p>
                Pricing depends on the catalogue, payments, delivery options
                and integrations required.
              </p>

              <span class="side-price">
                Custom quote
              </span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section about-avara">
      <div class="container">
        <div class="about-avara-card">
          <div class="about-avara-label">
            <span>AVARA</span>
            <small>by BLUVA</small>
          </div>

          <div class="about-avara-content">
            <p class="eyebrow">
              Direct support
            </p>

            <h2>
              One person behind every project.
            </h2>

            <p>
              I personally design and develop every project, from the first
              conversation through to launch. The goal is simple: give
              freelancers and small businesses a professional website without
              the cost and complexity of a large agency.
            </p>

            <p class="about-signature">
              Thomas — AVARA by BLUVA
            </p>

            <a href="#contact" class="button">
              Discuss my project
              <span class="button-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="section process-section">
      <div class="container">
        <div class="process-heading">
          <div>
            <p class="eyebrow">
              How it works
            </p>

            <h2>
              From your idea to launch,
              simply.
            </h2>
          </div>

          <p>
            A clear process to define the project, validate the result
            and avoid surprises.
          </p>
        </div>

        <div class="process-grid">
          <article class="process-card">
            <span class="process-number">01</span>
            <div class="process-icon">↗</div>

            <h3>Your project</h3>

            <p>
              We discuss your business, goals, content
              and the style you are looking for.
            </p>

            <span class="process-detail">
              Brief & scope
            </span>
          </article>

          <article class="process-card featured">
            <span class="process-number">02</span>
            <div class="process-icon">✦</div>

            <h3>Creation</h3>

            <p>
              The website is designed and developed around
              the structure and requirements agreed together.
            </p>

            <span class="process-detail">
              Design & development
            </span>
          </article>

          <article class="process-card">
            <span class="process-number">03</span>
            <div class="process-icon">✓</div>

            <h3>Review</h3>

            <p>
              We review the website together and make the final
              corrections before publication.
            </p>

            <span class="process-detail">
              30–60 min review meeting
            </span>
          </article>

          <article class="process-card">
            <span class="process-number">04</span>
            <div class="process-icon">↑</div>

            <h3>Launch</h3>

            <p>
              Domain, hosting, HTTPS and final checks:
              your website is ready for visitors.
            </p>

            <span class="process-detail">
              Publication
            </span>
          </article>
        </div>

        <div class="process-bottom">
          <div>
            <span class="process-bottom-label">
              After launch
            </span>

            <h3>
              Your website can keep evolving.
            </h3>

            <p>
              Update simple content yourself or ask AVARA by BLUVA
              whenever you want to add something new.
            </p>
          </div>

          <a href="#contact" class="button">
            Start my project
            <span class="button-arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact-section">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-content">
            <p class="eyebrow light-eyebrow">
              Your project
            </p>

            <h2>
              Let's talk about your
              <span>next website.</span>
            </h2>

            <p class="contact-intro">
              Business website, online store or improvements to an existing
              website: tell us about your project in a few lines.
            </p>

            <p class="contact-reassurance">
              Your idea does not need to be fully defined yet.
              Send us a message — we generally reply within one working day.
            </p>

            <div class="contact-points">
              <div class="contact-point">
                <span class="contact-point-icon">01</span>
                <div>
                  <strong>A first discussion</strong>
                  <p>
                    We identify what your project actually needs.
                  </p>
                </div>
              </div>

              <div class="contact-point">
                <span class="contact-point-icon">02</span>
                <div>
                  <strong>A tailored proposal</strong>
                  <p>
                    Scope and price are agreed before work starts.
                  </p>
                </div>
              </div>

              <div class="contact-point">
                <span class="contact-point-icon">03</span>
                <div>
                  <strong>No commitment at this stage</strong>
                  <p>
                    Sending a request simply starts the conversation.
                  </p>
                </div>
              </div>
            </div>

            <div class="contact-mini-card">
              <span class="contact-mini-dot"></span>

              <div>
                <strong>
                  Business websites from €790 excl. VAT
                </strong>

                <p>
                  E-commerce and specific requirements on request.
                </p>
              </div>
            </div>
          </div>

          <div class="contact-form-card">
            <div class="contact-form-heading">
              <span>Project enquiry</span>

              <h3>
                Tell us about your business.
              </h3>

              <p>
                A few details are enough to get started.
              </p>
            </div>

            <form
              name="demande-projet"
              method="POST"
              action="/en/thank-you/"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              class="contact-form"
            >
              <input
                type="hidden"
                name="form-name"
                value="demande-projet"
              />

              <p class="hidden-field">
                <label>
                  Do not fill in:
                  <input name="bot-field" />
                </label>
              </p>

              <div class="form-row">
                <div class="form-group">
                  <label for="name-en">
                    Name *
                  </label>

                  <input
                    id="name-en"
                    type="text"
                    name="name"
                    placeholder="John Smith"
                    autocomplete="name"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="company-en">
                    Company
                  </label>

                  <input
                    id="company-en"
                    type="text"
                    name="company"
                    placeholder="Your company"
                    autocomplete="organization"
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="email-en">
                    Email *
                  </label>

                  <input
                    id="email-en"
                    type="email"
                    name="email"
                    placeholder="you@company.com"
                    autocomplete="email"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="phone-en">
                    Phone
                  </label>

                  <input
                    id="phone-en"
                    type="tel"
                    name="phone"
                    placeholder="+32 ..."
                    autocomplete="tel"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="project-type-en">
                  Project type *
                </label>

                <div class="select-wrapper">
                  <select
                    id="project-type-en"
                    name="project-type"
                    required
                  >
                    <option value="">
                      Select an option
                    </option>

                    <option value="site-vitrine">
                      Business website
                    </option>

                    <option value="ecommerce">
                      E-commerce
                    </option>

                    <option value="refonte">
                      Existing website redesign
                    </option>

                    <option value="evolution">
                      New feature / website update
                    </option>

                    <option value="autre">
                      Other project
                    </option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="message-en">
                  Tell us about your project *
                </label>

                <textarea
                  id="message-en"
                  name="message"
                  rows="6"
                  placeholder="Briefly describe your business, what you need and any ideas you already have..."
                  required
                ></textarea>
              </div>

              <label class="form-consent">
                <input
                  type="checkbox"
                  name="privacy-acknowledgement"
                  value="yes"
                  required
                />

                <span>
                  I have read the
                  <a href="/en/privacy/" target="_blank">
                    privacy policy
                  </a>.
                </span>
              </label>

              <button
                type="submit"
                class="button contact-submit"
              >
                Send my enquiry
                <span class="button-arrow">→</span>
              </button>

              <p class="form-note">
                No payment or commitment at this stage.
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-content">
      <a href="/en/" class="footer-brand">
        <span>AVARA</span>
        <small>by BLUVA</small>
      </a>

      <p>
        © 2026 AVARA by BLUVA. All rights reserved.
      </p>

      <div class="footer-links">
        <a href="/en/legal-notice/">
          Legal notice
        </a>

        <a href="/en/privacy/">
          Privacy
        </a>
      </div>
    </div>
  </footer>
</Layout>
