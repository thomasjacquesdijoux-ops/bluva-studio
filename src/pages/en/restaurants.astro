---
import Layout from "../../layouts/Layout.astro";
import "../../styles/restaurants-en.css";
---

<Layout
  title="Restaurant websites | AVARA by BLUVA"
  description="Modern websites for restaurants, bistros and hospitality businesses in Belgium: menus, reservations, opening hours, galleries and practical information."
>
  <header class="restaurant-header">
    <div class="restaurant-container restaurant-nav">
      <a href="/en/" class="restaurant-logo" aria-label="AVARA by BLUVA">
        <img src="/images/logo-avara.png" alt="AVARA by BLUVA" />
      </a>

      <nav>
        <a href="#solution">Your website</a>
        <a href="#example">Example</a>
        <a href="#pricing">Pricing</a>
        <a href="#process">How it works</a>
        <a href="#faq">FAQ</a>
      </nav>

      <a href="/en/#contact" class="button-small">
        Discuss my project
      </a>
    </div>
  </header>

  <main>
    <section class="restaurant-hero">
      <div class="restaurant-container hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            Websites for restaurants
          </div>

          <h1>
            Make people want to book
            <span>before they even arrive.</span>
          </h1>

          <p class="hero-text">
            A modern website to showcase your restaurant, menu, opening hours
            and atmosphere — with an experience designed first and foremost
            for visitors on mobile.
          </p>

          <div class="hero-actions">
            <a href="/en/#contact" class="button-primary">
              Discuss my project
              <span>→</span>
            </a>

            <a href="#example" class="button-secondary">
              View an example
            </a>
          </div>

          <div class="hero-points">
            <div>
              <strong>From €790</strong>
              <span>Excl. VAT · Business website</span>
            </div>

            <div>
              <strong>€59 / year</strong>
              <span>Hosting & light maintenance</span>
            </div>

            <div>
              <strong>100% responsive</strong>
              <span>Designed for mobile</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image">
            <div class="hero-site">
              <div class="site-topbar">
                <div class="site-brand">
                  LE COMPTOIR <span>27</span>
                </div>

                <div class="site-menu">
                  <span>Menu</span>
                  <span>Restaurant</span>
                  <span>Contact</span>
                  <strong>Book</strong>
                </div>
              </div>

              <div class="site-copy">
                <span>Bistro · Seasonal cuisine</span>

                <h2>
                  Food made to be shared.
                </h2>

                <p>
                  Seasonal produce, generous cooking and a place
                  designed for memorable moments.
                </p>

                <div class="fake-buttons">
                  <strong>Book a table</strong>
                  <span>View the menu</span>
                </div>
              </div>

              <div class="opening-card">
                <small>OPENING HOURS</small>
                <strong>Tue — Sat</strong>
                <span>12:00 — 14:30</span>
                <span>18:30 — 22:30</span>
              </div>
            </div>
          </div>

          <div class="floating-mobile">
            <div class="mobile-top">
              <strong>LE COMPTOIR 27</strong>
              <span>☰</span>
            </div>

            <div class="mobile-photo"></div>

            <small>Seasonal cuisine</small>

            <h3>
              A table,
              a story.
            </h3>

            <div class="mobile-reserve">
              Book
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="restaurant-proof">
      <div class="restaurant-container proof-grid">
        <div>
          <strong>Menu</strong>
          <span>Accessible in seconds</span>
        </div>

        <div>
          <strong>Reservations</strong>
          <span>Your existing tool or booking form</span>
        </div>

        <div>
          <strong>Opening hours</strong>
          <span>Immediately visible</span>
        </div>

        <div>
          <strong>Mobile</strong>
          <span>Designed for customers on the go</span>
        </div>
      </div>
    </section>

    <section id="solution" class="section solution-section">
      <div class="restaurant-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Your website</p>

            <h2>
              Everything a customer looks for before booking.
            </h2>
          </div>

          <p>
            You do not need a complicated website. The goal is to create
            desire, answer the essential questions immediately and naturally
            guide visitors towards a reservation.
          </p>
        </div>

        <div class="feature-grid">
          <article class="feature-card feature-main">
            <span class="feature-number">01</span>
            <div class="feature-icon">☰</div>
            <h3>Your menu</h3>
            <p>
              A mobile-friendly menu that is easy to browse and far more
              pleasant than a PDF hidden somewhere on the website.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">02</span>
            <div class="feature-icon">↗</div>
            <h3>Reservations</h3>
            <p>
              Already using Zenchef, TheFork, Resengo or another solution?
              Your existing booking system can usually be connected directly.
              If you do not have one yet, we can help you choose.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">03</span>
            <div class="feature-icon">⌖</div>
            <h3>Location & opening hours</h3>
            <p>
              Address, opening hours, phone number and directions
              are available without searching.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">04</span>
            <div class="feature-icon">◇</div>
            <h3>Your atmosphere</h3>
            <p>
              Photography, visual identity and layout that feel consistent
              with the experience of your establishment.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">05</span>
            <div class="feature-icon">◎</div>
            <h3>Google & SEO</h3>
            <p>
              A clean technical structure that helps Google understand
              and correctly index your website.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">06</span>
            <div class="feature-icon">✦</div>
            <h3>Easy to update</h3>
            <p>
              Opening hours, text and key information can be updated
              without rebuilding the whole website.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="ecosystem-section">
      <div class="restaurant-container">
        <div class="ecosystem-card">
          <div class="ecosystem-copy">
            <p class="eyebrow">Your online presence</p>

            <h2>
              Already active on Google and Instagram?
              That's a good thing.
            </h2>

            <p>
              Your website does not replace your other channels. It brings
              them together and gives visitors one reliable place to find your
              atmosphere, menu, opening hours and reservation options.
            </p>
          </div>

          <div class="ecosystem-flow">
            <div class="ecosystem-item">
              <span class="ecosystem-icon">G</span>
              <div>
                <strong>Google</strong>
                <p>Helps people find you.</p>
              </div>
            </div>

            <div class="ecosystem-arrow">→</div>

            <div class="ecosystem-item">
              <span class="ecosystem-icon">◎</span>
              <div>
                <strong>Instagram</strong>
                <p>Helps people discover you.</p>
              </div>
            </div>

            <div class="ecosystem-arrow">→</div>

            <div class="ecosystem-item ecosystem-main">
              <span class="ecosystem-icon">A</span>
              <div>
                <strong>Your website</strong>
                <p>Helps people understand and book.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mobile-first">
      <div class="restaurant-container mobile-first-grid">
        <div class="mobile-first-copy">
          <p class="eyebrow">Mobile first</p>

          <h2>
            Your customer may already be nearby when they search for your restaurant.
          </h2>

          <p>
            Address, menu, opening hours, phone number and reservations
            should all be immediately accessible on a smartphone.
          </p>

          <div class="mobile-list">
            <div><span>✓</span> Fast loading</div>
            <div><span>✓</span> Simple navigation</div>
            <div><span>✓</span> Visible booking button</div>
            <div><span>✓</span> Phone number and directions at hand</div>
          </div>
        </div>

        <div class="phones">
          <div class="phone phone-back">
            <div class="phone-screen menu-screen">
              <small>LE COMPTOIR 27</small>
              <h3>The menu</h3>

              <div class="menu-line"><span>Starters</span><strong>→</strong></div>
              <div class="menu-line"><span>Main courses</span><strong>→</strong></div>
              <div class="menu-line"><span>Desserts</span><strong>→</strong></div>
              <div class="menu-line"><span>Wines</span><strong>→</strong></div>
            </div>
          </div>

          <div class="phone phone-front">
            <div class="phone-screen home-screen">
              <div class="phone-image"></div>
              <small>BISTRO · NALINNES</small>

              <h3>
                Food made to be shared.
              </h3>

              <p>
                Open today
                <strong>12:00 — 14:30</strong>
              </p>

              <div class="phone-button">
                Book a table
              </div>

              <div class="phone-links">
                <span>Menu</span>
                <span>Directions</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="example" class="section example-section">
      <div class="restaurant-container">
        <div class="section-heading example-heading">
          <div>
            <p class="eyebrow">Example</p>
            <h2>Le Comptoir 27</h2>
          </div>

          <p>
            A demonstration concept created by AVARA to show what a
            contemporary restaurant website can look like.
          </p>
        </div>

        <div class="example-browser">
          <div class="browser-bar">
            <div class="browser-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="browser-url">lecomptoir27.be</div>
          </div>

          <div class="example-page">
            <nav class="example-nav">
              <strong>LE COMPTOIR <span>27</span></strong>

              <div>
                <span>Home</span>
                <span>Menu</span>
                <span>Restaurant</span>
                <span>Gallery</span>
                <span>Contact</span>
                <b>Book</b>
              </div>
            </nav>

            <div class="example-hero">
              <div>
                <small>Bistro · Seasonal cuisine</small>

                <h3>
                  Food made to be shared.
                </h3>

                <p>
                  Seasonal cooking in a warm atmosphere, built around
                  great produce and the pleasure of welcoming guests.
                </p>

                <div class="example-actions">
                  <strong>Book a table</strong>
                  <span>View the menu</span>
                </div>
              </div>
            </div>

            <div class="example-bottom">
              <div>
                <small>01</small>
                <strong>The menu</strong>
                <span>Discover →</span>
              </div>

              <div>
                <small>02</small>
                <strong>Book</strong>
                <span>Choose a table →</span>
              </div>

              <div>
                <small>03</small>
                <strong>Find us</strong>
                <span>Directions →</span>
              </div>
            </div>
          </div>
        </div>

        <p class="demo-note">
          Le Comptoir 27 is a demonstration concept and is not presented
          as an AVARA client.
        </p>
      </div>
    </section>

    <section id="pricing" class="section pricing-section">
      <div class="restaurant-container">
        <div class="pricing-layout">
          <div class="pricing-copy">
            <p class="eyebrow">Pricing</p>

            <h2>
              A professional website without an agency-sized budget.
            </h2>

            <p>
              For a restaurant that wants to present its business,
              menu and booking options, our business website package
              is usually an excellent starting point.
            </p>
          </div>

          <div class="pricing-card">
            <div class="price-top">
              <span>Restaurant website</span>

              <div class="price">
                <small>From</small>
                <strong>€790</strong>
                <small>excl. VAT</small>
              </div>
            </div>

            <div class="price-features">
              <div><span>✓</span> Up to 5 pages</div>
              <div><span>✓</span> Responsive design</div>
              <div><span>✓</span> Menu presentation</div>
              <div><span>✓</span> Contact form</div>
              <div><span>✓</span> Simple booking link or integration</div>
              <div><span>✓</span> Google Maps / directions</div>
              <div><span>✓</span> Basic technical SEO</div>
              <div><span>✓</span> Launch included</div>
              <div><span>✓</span> Content management training</div>
              <div><span>✓</span> Review meeting</div>
            </div>

            <div class="hosting">
              <div>
                <strong>Hosting & light maintenance</strong>
                <span>No mandatory monthly subscription</span>
              </div>

              <strong>€59 excl. VAT / year</strong>
            </div>

            <a href="/en/#contact" class="button-primary full-button">
              Discuss my restaurant
              <span>→</span>
            </a>

            <p class="price-reassurance">
              The exact price is confirmed before the project starts.
              No additional cost is added without your approval.
            </p>

            <p class="price-note">
              Advanced booking, online ordering, multilingual content
              and external integrations are quoted separately when required.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="process" class="section process-section">
      <div class="restaurant-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">How it works</p>

            <h2>
              You keep running your restaurant.
              We take care of the website.
            </h2>
          </div>

          <p>
            A deliberately simple process designed to minimise the time
            you need to spend on the project.
          </p>
        </div>

        <div class="process-grid">
          <article>
            <span>01</span>
            <h3>Discussion</h3>
            <p>Your establishment, customers, identity and needs.</p>
          </article>

          <article>
            <span>02</span>
            <h3>Content</h3>
            <p>You provide photos, menu, contact details and key information.</p>
          </article>

          <article>
            <span>03</span>
            <h3>Creation</h3>
            <p>We design the website around your establishment and audience.</p>
          </article>

          <article>
            <span>04</span>
            <h3>Launch</h3>
            <p>Final corrections, domain, HTTPS and publication.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="faq" class="section faq-section">
      <div class="restaurant-container">
        <div class="section-heading faq-heading">
          <div>
            <p class="eyebrow">Frequently asked questions</p>

            <h2>
              Questions restaurant owners often ask.
            </h2>
          </div>

          <p>
            The goal is to keep the project simple. Specific requirements
            are identified before work begins, so you know exactly
            what is included.
          </p>
        </div>

        <div class="faq-grid">
          <details class="faq-item">
            <summary>
              Can I keep my existing booking system?
              <span>+</span>
            </summary>

            <p>
              Yes. If you already use Zenchef, TheFork, Resengo or another
              platform, we can usually provide direct access to your existing
              booking solution. More advanced integrations are assessed
              according to the platform used.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Can I update my menu and opening hours myself?
              <span>+</span>
            </summary>

            <p>
              Yes. The website can be configured so that essential content
              such as text, opening hours and key menu information can be
              updated easily.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Is the domain name included?
              <span>+</span>
            </summary>

            <p>
              We can handle the connection and configuration of your domain.
              If you already own one, it can usually be kept. Domain purchase
              or renewal fees remain separate from the website package.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              Can the website be multilingual?
              <span>+</span>
            </summary>

            <p>
              Yes. A multilingual website is entirely possible. Because it
              involves additional pages, content and configuration, it is
              priced according to the scope of the project.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              What if I want to add features later?
              <span>+</span>
            </summary>

            <p>
              Your website can evolve. New pages, galleries, online ordering,
              integrations and other improvements can be added later as your
              needs change.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="restaurant-container">
        <div class="cta-card">
          <div>
            <p class="eyebrow light">
              Your restaurant
            </p>

            <h2>
              What if your next customer discovered you here?
            </h2>

            <p>
              Tell us about your establishment and what you would like to
              improve. One first conversation is enough to see what AVARA
              can offer.
            </p>
          </div>

          <div class="cta-actions">
            <a href="/en/#contact" class="cta-white">
              Discuss my project
              <span>→</span>
            </a>

            <a href="mailto:contact@avarastudio.be" class="cta-mail">
              contact@avarastudio.be
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="restaurant-footer">
    <div class="restaurant-container footer-inner">
      <a href="/en/" class="footer-logo">
        <span>AVARA</span>
        <small>by BLUVA</small>
      </a>

      <p>© 2026 AVARA by BLUVA.</p>

      <div>
        <a href="/en/">Home</a>
        <a href="/en/legal-notice/">Legal notice</a>
        <a href="/en/privacy/">Privacy</a>
      </div>
    </div>
  </footer>
</Layout>
